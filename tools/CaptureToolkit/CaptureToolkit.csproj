<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ViewGrid.Tools.CaptureToolkit</RootNamespace>
    <!-- ローカルツールでローカル配列リテラル / グローバライズ周りの警告を許容 -->
    <NoWarn>$(NoWarn);CA1861;CA1303;CA1862;CA1305;CA1307;CA1311;CA1308;CA1310;CA1869;CA1870</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
  </ItemGroup>
</Project>
