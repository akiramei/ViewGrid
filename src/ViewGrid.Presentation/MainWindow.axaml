<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
        xmlns:history="clr-namespace:ViewGrid.Application.History;assembly=ViewGrid.Application"
        xmlns:converters="clr-namespace:ViewGrid.Presentation.Converters"
        xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ViewGrid.Presentation.MainWindow"
        x:Name="MainWindowRoot"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <!--
        Window レベル KeyBinding。
        Undo/Redo: Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z
        タブ切替: Ctrl+1（準備）/ Ctrl+2（配置）— P8 のショートカット拡充
    -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <!--
            履歴 Flyout 内の ListBox 各項目テンプレート。
            列構成:
              Col0: 現在位置インジケータ（▶、IsCurrent のみ表示）
              Col1: 適用/取消グリフ（✓ または ○）
              Col2: 説明文（IsApplied=false なら Opacity 0.5）
        -->
        <DataTemplate x:Key="HistoryItemTemplate" x:DataType="history:HistoryEntry">
            <!--
                Grid.Background は MultiBinding で「hover ジャンプ範囲内かどうか」を判定し、
                Undo 方向は半透明赤、Redo 方向は半透明緑で塗る（Phase 3 のプレビュー）。
                範囲外は Transparent で素通し。
                PointerEntered/Exited は CodeBehind で MainWindowViewModel.HoveredHistoryIndex を
                更新する（hover 解除は Exited で null セット）。
            -->
            <Grid ColumnDefinitions="20,Auto,*"
                  MinHeight="28"
                  PointerEntered="OnHistoryItemPointerEntered"
                  PointerExited="OnHistoryItemPointerExited">
                <Grid.Background>
                    <MultiBinding Converter="{x:Static converters:HoveredJumpRangeBackgroundConverter.Instance}">
                        <Binding Path="Index" />
                        <Binding ElementName="MainWindowRoot" Path="DataContext.HoveredJumpRangeLo" />
                        <Binding ElementName="MainWindowRoot" Path="DataContext.HoveredJumpRangeHi" />
                        <Binding ElementName="MainWindowRoot" Path="DataContext.HoveredJumpDirection" />
                    </MultiBinding>
                </Grid.Background>
                <TextBlock Grid.Column="0"
                           Text="▶"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemAccentColor}"
                           IsVisible="{Binding IsCurrent}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding IsApplied, Converter={x:Static converters:BoolToHistoryGlyphConverter.Instance}}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Opacity="0.5" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Description}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Opacity="{Binding IsApplied, Converter={x:Static converters:BoolToOpacityConverter.Instance}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
        P1+P5 全体レイアウト: Row 0 にメニュー + 履歴ツールバー、Row 1 に TabControl、
        Row 2 にコンテキスト依存ヒントバー（永続ヒントバー）、Row 3 にステータスバー（最下部固定）。
        Row 1 のキャンバス領域は伸縮し、上下の補助 UI と区別される。
        ヒントバーは <see cref="MainWindowViewModel.CurrentHints"/> が空のとき折り畳まれる。
    -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0" LastChildFill="False">
            <!-- P3: メニューバー充実（ファイル / 編集 / 表示 / ヘルプ） -->
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="ファイル">
                    <MenuItem Header="画像を追加..."
                              InputGesture="Ctrl+O"
                              Command="{Binding AssetLibrary.PickFilesAndImportCommand}"
                              ToolTip.Tip="ファイルダイアログから画像を取り込みます。ドラッグ&amp;ドロップでも追加できます。" />
                    <Separator />
                    <MenuItem Header="終了"
                              InputGesture="Alt+F4"
                              Click="OnExitClicked" />
                </MenuItem>
                <MenuItem Header="編集">
                    <MenuItem Header="{Binding UndoLabel}"
                              Command="{Binding UndoCommand}"
                              InputGesture="Ctrl+Z" />
                    <MenuItem Header="{Binding RedoLabel}"
                              Command="{Binding RedoCommand}"
                              InputGesture="Ctrl+Y" />
                </MenuItem>
                <MenuItem Header="表示">
                    <MenuItem Header="準備タブ"
                              InputGesture="Ctrl+1"
                              Click="OnShowPreparationTabClicked" />
                    <MenuItem Header="配置タブ"
                              InputGesture="Ctrl+2"
                              Click="OnShowLayoutTabClicked" />
                </MenuItem>
                <MenuItem Header="ヘルプ">
                    <MenuItem Header="ViewGrid について"
                              Click="OnAboutClicked" />
                </MenuItem>
            </Menu>

            <!--
                右: 履歴ツールバー。配置は「← →  ▼」の順。
                Undo / Redo は連続操作される「ペア」なので隣接させる（VS Code / Word の慣例）。
                履歴ドロップダウンは Undo/Redo の派生機能として右側に分離して配置する。
                Undo↔Redo 間は Spacing=2（密）、Redo↔▼ 間は Margin で 8px 余白（疎）にして
                視覚的にも「ペア + 補助」の階層を表現する。
            -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="0,2,8,2">
                <Button Classes="toolbar"
                        Command="{Binding UndoCommand}"
                        ToolTip.Tip="{Binding UndoLabel}">
                    <PathIcon Data="{StaticResource UndoGeometry}" Width="14" Height="14" />
                </Button>

                <Button Classes="toolbar"
                        Command="{Binding RedoCommand}"
                        ToolTip.Tip="{Binding RedoLabel}">
                    <PathIcon Data="{StaticResource RedoGeometry}" Width="14" Height="14" />
                </Button>

                <Button x:Name="HistoryDropdownButton"
                        Classes="toolbar"
                        Margin="8,0,0,0"
                        ToolTip.Tip="操作履歴">
                    <PathIcon Data="{StaticResource ChevronDownGeometry}" Width="12" Height="12" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="Standard">
                            <Border MinWidth="320" MaxWidth="500" MaxHeight="500">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Row="0"
                                               Text="操作履歴（最新 50 件）"
                                               FontWeight="SemiBold"
                                               Margin="12,8" />
                                    <ListBox Grid.Row="1"
                                             x:Name="HistoryListBox"
                                             ItemsSource="{Binding HistoryEntries}"
                                             ItemTemplate="{StaticResource HistoryItemTemplate}"
                                             SelectionMode="Single"
                                             BorderThickness="0,1,0,0"
                                             Background="Transparent"
                                             IsVisible="{Binding HasHistory}"
                                             PointerReleased="OnHistoryItemClicked" />
                                    <TextBlock Grid.Row="1"
                                               Text="操作履歴はありません"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.5"
                                               IsVisible="{Binding !HasHistory}" />
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1"
                    Classes="MainTabs"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource PrepareGeometry}" Width="18" Height="18" />
                        <TextBlock Text="準備" />
                    </StackPanel>
                </TabItem.Header>
                <!-- 右ペイン幅 380 → 440 で特性編集の窮屈さを緩和。アセット領域は伸縮 -->
                <Grid ColumnDefinitions="*,440">
                    <views:AssetLibraryView Grid.Column="0"
                                            DataContext="{Binding AssetLibrary}" />

                    <Border Grid.Column="1"
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4*" MinHeight="200" />
                            </Grid.RowDefinitions>
                            <views:CopyListView Grid.Row="0"
                                                DataContext="{Binding CopyList}" />
                            <GridSplitter Grid.Row="1"
                                          Height="4"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows"
                                          Background="{DynamicResource SystemBaseLowColor}" />
                            <!--
                                Phase 3 C 案: 右ペイン下部を TabControl 化し、「特性編集」と「履歴」を並べる。
                                履歴 Flyout はツールバーに残しているため、配置タブからも引き続きアクセス可能。
                                準備タブの常時表示で履歴を見ながら編集できる UX を提供する。
                            -->
                            <TabControl Grid.Row="2" Padding="0">
                                <TabItem Header="特性編集">
                                    <views:CopyPropertiesView DataContext="{Binding CopyProperties}" />
                                </TabItem>
                                <TabItem Header="履歴">
                                    <Grid RowDefinitions="*,Auto">
                                        <ListBox Grid.Row="0"
                                                 ItemsSource="{Binding HistoryEntries}"
                                                 ItemTemplate="{StaticResource HistoryItemTemplate}"
                                                 SelectionMode="Single"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 IsVisible="{Binding HasHistory}"
                                                 PointerReleased="OnHistoryItemClicked" />
                                        <TextBlock Grid.Row="0"
                                                   Text="操作履歴はありません"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"
                                                   IsVisible="{Binding !HasHistory}" />
                                        <TextBlock Grid.Row="1"
                                                   Text="hover で範囲を視覚化（赤=Undo / 青=Redo）。クリックでジャンプ。"
                                                   FontSize="10"
                                                   Opacity="0.6"
                                                   Margin="8,4"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource LayoutGeometry}" Width="18" Height="18" />
                        <TextBlock Text="配置" />
                    </StackPanel>
                </TabItem.Header>
                <!--
                    配置タブを「上=コンパクトなグリッド切替バー / 下=ワークスペース」の縦 2 段構造へ変更。
                    旧来の左 300px 縦長グリッド一覧は「複数グリッドを行き来する作業ではない」割に
                    大きなスペースを占有していたため、ComboBox + 操作ボタンに縮約してその分の幅を
                    GridWorkspaceView 内部の 3 ペイン（配置元 / キャンバス / プロパティ）へ譲る。
                -->
                <Grid RowDefinitions="Auto,*">
                    <views:GridCanvasListView Grid.Row="0"
                                              DataContext="{Binding GridList}" />
                    <views:GridWorkspaceView Grid.Row="1"
                                             DataContext="{Binding GridWorkspace}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!--
            永続ヒントバー（Row 2）: 現在のコンテキスト（タブ + 主な選択）に応じた操作ヒントを
            1 行で表示する。CurrentHints が空文字の時は IsVisible=False で折り畳んで占有 0 にする。
            邪魔だと感じるユーザー向けに将来「閉じる」ボタンや設定で無効化できるようにする余地を残す。
        -->
        <Border Grid.Row="2"
                Classes="HintStripe"
                IsVisible="{Binding CurrentHints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="HintStripeText"
                       Text="{Binding CurrentHints}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!--
            P5: ステータスバー。準備タブ/配置タブの状態 + 未保存バッジ + 履歴件数を最下部に常駐表示する。
            VS Code / IntelliJ などのプロ向け IDE と同じ位置感。
            左: フェーズ + 件数（準備: N 件 / 配置: グリッド名 N×M セル）
            中央: 未保存バッジ（CopyProperties / PlacementInspector の IsDirty 集計）。アクセント色で強調。
            右: 履歴件数（履歴: 5/12）
        -->
        <Border Grid.Row="3" Classes="StatusBar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Classes="StatusBarText"
                           Text="{Binding StatusSummary}" />
                <TextBlock Grid.Column="1"
                           Classes="StatusBarText"
                           Foreground="{DynamicResource SystemAccentColor}"
                           FontWeight="SemiBold"
                           Opacity="1"
                           Margin="0,0,16,0"
                           Text="{Binding UnsavedSummary}"
                           ToolTip.Tip="特性編集 / Inspector に未保存の編集があります。各タブの「保存」ボタンで永続化してください。"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Grid.Column="2"
                           Classes="StatusBarText"
                           Text="{Binding HistorySummary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
