<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
        xmlns:history="clr-namespace:ViewGrid.Application.History;assembly=ViewGrid.Application"
        xmlns:converters="clr-namespace:ViewGrid.Presentation.Converters"
        xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
        xmlns:loc="using:ViewGrid.Presentation.Localization"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ViewGrid.Presentation.MainWindow"
        x:Name="MainWindowRoot"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <!--
        Window レベル KeyBinding。MenuItem.InputGesture は表示ヒントのみで実際のキー入力には
        反応しないため（Avalonia 12 既定）、KeyBinding として明示的に登録する必要がある。
        Undo/Redo:        Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z
        画像追加:         Ctrl+O
        新規バリアント:   Ctrl+N（配置タブ専用、SelectedCandidate 必須）
        PNG エクスポート: Ctrl+E（CurrentGrid 必須）

        ※ タブ切替 (Ctrl+1/2) は Stage 4 で TabControl 撤去のため不要。
    -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AssetLibrary.PickFilesAndImportCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding GridWorkspace.Variants.BeginCreateVariantCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding GridWorkspace.Output.ExportToPngCommand}" />
        <!-- 設定ダイアログ (Ctrl+,) は code-behind の KeyDown ハンドラで処理。
             KeyBindings 内 ElementName 参照が NameScope の都合で解決しないため。 -->
    </Window.KeyBindings>

    <Window.Resources>
        <!--
            履歴 Flyout 内の ListBox 各項目テンプレート。
            列構成:
              Col0: 現在位置インジケータ（▶、IsCurrent のみ表示）
              Col1: 適用/取消グリフ（✓ または ○）
              Col2: 説明文（IsApplied=false なら Opacity 0.5）
        -->
        <DataTemplate x:Key="HistoryItemTemplate" x:DataType="history:HistoryEntry">
            <!--
                Grid.Background は MultiBinding で「hover ジャンプ範囲内かどうか」を判定し、
                Undo 方向は半透明赤、Redo 方向は半透明緑で塗る（Phase 3 のプレビュー）。
                範囲外は Transparent で素通し。
                PointerEntered/Exited は CodeBehind で MainWindowViewModel.HoveredHistoryIndex を
                更新する（hover 解除は Exited で null セット）。
            -->
            <Grid ColumnDefinitions="20,Auto,*"
                  MinHeight="28"
                  PointerEntered="OnHistoryItemPointerEntered"
                  PointerExited="OnHistoryItemPointerExited">
                <Grid.Background>
                    <MultiBinding Converter="{x:Static converters:HoveredJumpRangeBackgroundConverter.Instance}">
                        <Binding Path="Index" />
                        <Binding ElementName="MainWindowRoot" Path="((vm:MainWindowViewModel)DataContext).HoveredJumpRangeLo" />
                        <Binding ElementName="MainWindowRoot" Path="((vm:MainWindowViewModel)DataContext).HoveredJumpRangeHi" />
                        <Binding ElementName="MainWindowRoot" Path="((vm:MainWindowViewModel)DataContext).HoveredJumpDirection" />
                    </MultiBinding>
                </Grid.Background>
                <TextBlock Grid.Column="0"
                           Text="▶"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemAccentColor}"
                           IsVisible="{Binding IsCurrent}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding IsApplied, Converter={x:Static converters:BoolToHistoryGlyphConverter.Instance}}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Opacity="0.5" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Description}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Opacity="{Binding IsApplied, Converter={x:Static converters:BoolToOpacityConverter.Instance}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
        P1+P5 全体レイアウト: Row 0 にメニュー + 履歴ツールバー、Row 1 に TabControl、
        Row 2 にコンテキスト依存ヒントバー（永続ヒントバー）、Row 3 にステータスバー（最下部固定）。
        Row 1 のキャンバス領域は伸縮し、上下の補助 UI と区別される。
        ヒントバーは <see cref="MainWindowViewModel.CurrentHints"/> が空のとき折り畳まれる。
    -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0" LastChildFill="False">
            <!-- P3: メニューバー (ファイル / 編集 / ヘルプ)。 i18n: {loc:Tr} で全文字列を切替 -->
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="{loc:Tr Menu_File}">
                    <MenuItem Header="{loc:Tr MenuItem_AddImages}"
                              InputGesture="Ctrl+O"
                              Command="{Binding AssetLibrary.PickFilesAndImportCommand}"
                              ToolTip.Tip="{loc:Tr MenuItem_AddImages_Tooltip}" />
                    <MenuItem Header="{loc:Tr MenuItem_NewVariant}"
                              InputGesture="Ctrl+N"
                              Command="{Binding GridWorkspace.Variants.BeginCreateVariantCommand}"
                              ToolTip.Tip="{loc:Tr MenuItem_NewVariant_Tooltip}" />
                    <MenuItem Header="{loc:Tr MenuItem_ExportPng}"
                              InputGesture="Ctrl+E"
                              Command="{Binding GridWorkspace.Output.ExportToPngCommand}"
                              ToolTip.Tip="{loc:Tr MenuItem_ExportPng_Tooltip}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr MenuItem_Workspace}"
                              Click="OnWorkspaceSwitchClicked"
                              ToolTip.Tip="{loc:Tr MenuItem_Workspace_Tooltip}" />
                    <MenuItem Header="{loc:Tr MenuItem_Settings}"
                              InputGesture="Ctrl+,"
                              Click="OnSettingsClicked"
                              ToolTip.Tip="{loc:Tr MenuItem_Settings_Tooltip}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr MenuItem_Exit}"
                              InputGesture="Alt+F4"
                              Click="OnExitClicked" />
                </MenuItem>
                <MenuItem Header="{loc:Tr Menu_Edit}">
                    <MenuItem Header="{Binding UndoLabel}"
                              Command="{Binding UndoCommand}"
                              InputGesture="Ctrl+Z" />
                    <MenuItem Header="{Binding RedoLabel}"
                              Command="{Binding RedoCommand}"
                              InputGesture="Ctrl+Y" />
                </MenuItem>
                <MenuItem Header="{loc:Tr Menu_Help}">
                    <MenuItem Header="{loc:Tr MenuItem_LicenseNotices}"
                              Click="OnLicenseNoticesClicked"
                              ToolTip.Tip="{loc:Tr MenuItem_LicenseNotices_Tooltip}" />
                    <MenuItem Header="{loc:Tr MenuItem_About}"
                              Click="OnAboutClicked" />
                </MenuItem>
            </Menu>

            <!--
                右: 履歴ツールバー。配置は「← →  ▼」の順。
                Undo / Redo は連続操作される「ペア」なので隣接させる（VS Code / Word の慣例）。
                履歴ドロップダウンは Undo/Redo の派生機能として右側に分離して配置する。
                Undo↔Redo 間は Spacing=2（密）、Redo↔▼ 間は Margin で 8px 余白（疎）にして
                視覚的にも「ペア + 補助」の階層を表現する。
            -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="0,2,8,2">
                <Button Classes="toolbar"
                        Command="{Binding UndoCommand}"
                        ToolTip.Tip="{Binding UndoLabel}">
                    <PathIcon Data="{StaticResource UndoGeometry}" Width="14" Height="14" />
                </Button>

                <Button Classes="toolbar"
                        Command="{Binding RedoCommand}"
                        ToolTip.Tip="{Binding RedoLabel}">
                    <PathIcon Data="{StaticResource RedoGeometry}" Width="14" Height="14" />
                </Button>

                <Button x:Name="HistoryDropdownButton"
                        Classes="toolbar"
                        Margin="8,0,0,0"
                        ToolTip.Tip="{loc:Tr History_Tooltip}">
                    <PathIcon Data="{StaticResource ChevronDownGeometry}" Width="12" Height="12" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="Standard">
                            <Border MinWidth="320" MaxWidth="500" MaxHeight="500">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Row="0"
                                               Text="{loc:Tr History_Header}"
                                               FontWeight="SemiBold"
                                               Margin="12,8" />
                                    <ListBox Grid.Row="1"
                                             x:Name="HistoryListBox"
                                             ItemsSource="{Binding HistoryEntries}"
                                             ItemTemplate="{StaticResource HistoryItemTemplate}"
                                             SelectionMode="Single"
                                             BorderThickness="0,1,0,0"
                                             Background="Transparent"
                                             IsVisible="{Binding HasHistory}"
                                             PointerReleased="OnHistoryItemClicked" />
                                    <TextBlock Grid.Row="1"
                                               Text="{loc:Tr History_Empty}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.5"
                                               IsVisible="{Binding !HasHistory}" />
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </DockPanel>

        <!--
            配置ファースト UI 第 2 段階 Stage 4: 準備タブ完全廃止。
            旧 TabControl (準備 / 配置) を撤去し、配置ワークスペースを直接表示する。
            画像追加 / バリアント新規・リネーム / 特性編集 はすべて配置タブ内に統合済み
            （Stage 1〜3）。準備タブにあった「履歴」サブタブはツールバー右の Flyout に集約。
            上 = コンパクトなグリッド切替バー、下 = ワークスペース 3 ペイン構造を保持。
        -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <views:GridCanvasListView Grid.Row="0"
                                      DataContext="{Binding GridList}" />
            <views:GridWorkspaceView Grid.Row="1"
                                     DataContext="{Binding GridWorkspace}" />
        </Grid>

        <!--
            永続ヒントバー（Row 2）: 現在のコンテキスト（タブ + 主な選択）に応じた操作ヒントを
            1 行で表示する。CurrentHints が空文字の時は IsVisible=False で折り畳んで占有 0 にする。
            邪魔だと感じるユーザー向けに将来「閉じる」ボタンや設定で無効化できるようにする余地を残す。
        -->
        <Border Grid.Row="2"
                Classes="HintStripe"
                IsVisible="{Binding CurrentHints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="HintStripeText"
                       Text="{Binding CurrentHints}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!--
            P5: ステータスバー。準備タブ/配置タブの状態 + 未保存バッジ + 履歴件数を最下部に常駐表示する。
            VS Code / IntelliJ などのプロ向け IDE と同じ位置感。
            左: フェーズ + 件数（準備: N 件 / 配置: グリッド名 N×M セル）
            中央: 未保存バッジ（CopyProperties / PlacementInspector の IsDirty 集計）。アクセント色で強調。
            右: 履歴件数（履歴: 5/12）
        -->
        <Border Grid.Row="3" Classes="StatusBar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Classes="StatusBarText"
                           Text="{Binding StatusSummary}" />
                <TextBlock Grid.Column="1"
                           Classes="StatusBarText"
                           Foreground="{DynamicResource SystemAccentColor}"
                           FontWeight="SemiBold"
                           Opacity="1"
                           Margin="0,0,16,0"
                           Text="{Binding UnsavedSummary}"
                           ToolTip.Tip="{loc:Tr StatusBar_Unsaved_Tooltip}"
                           IsVisible="{Binding HasUnsavedChanges}" />
                <TextBlock Grid.Column="2"
                           Classes="StatusBarText"
                           Text="{Binding HistorySummary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
