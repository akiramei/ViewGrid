<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ViewGrid 共通スタイル。
        FontSize / Opacity / Margin / 色をハードコードしてきた各ビューを Class 適用に置換し、
        視覚階層を統一する。色や数値を変えたい場合はここを 1 箇所修正すれば全画面に反映される。

        使い方:
            <TextBlock Classes="SectionHeader" Text="特性編集" />
            <TextBlock Classes="FieldLabel" Text="名前" />
            <TextBlock Classes="HintText" Text="..." />
            <Border Classes="WarningBanner">...</Border>
            <Border Classes="InfoBanner">...</Border>
            <Border Classes="Card">...</Border>
            <StackPanel Classes="FormSection">...</StackPanel>
            <StackPanel Classes="FormGroup">...</StackPanel>
    -->

    <!--
        P1 デザインシステム: アプリ全体のフォント。
        日本語向けに "Yu Gothic UI" / "Meiryo UI" を優先し、ASCII は "Segoe UI Variable" / "Segoe UI"。
        Latin / 日本語ともに字幅・字形が統一され、FluentTheme 既定のばらつきを抑制。
    -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif" />
    </Style>

    <!-- セクション見出し（パネル単位、サブグループ単位の小見出し共通） -->
    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 入力欄のラベル（コンボ・テキストボックスの上に置く） -->
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 補足ヒント（小さい説明文） -->
    <Style Selector="TextBlock.HintText">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 黄色い注意バナー -->
    <Style Selector="Border.WarningBanner">
        <Setter Property="Background" Value="#22FFC107" />
        <Setter Property="BorderBrush" Value="#FFC107" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- 青い情報バナー -->
    <Style Selector="Border.InfoBanner">
        <Setter Property="Background" Value="#223399FF" />
        <Setter Property="BorderBrush" Value="#3399FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!--
        P1: カードスタイル。各セクションを Card で囲むことで「群」が視覚的に分かれ、
        密度の高い右ペインでも情報のまとまりが見えるようになる。
        ・背景 ViewGridCardBackground（柔らかい灰色）
        ・薄い border + 6px CornerRadius（FluentTheme の rounded corner と整合）
        ・内側 Padding 12（FormSection の Spacing=4 / FormGroup の Spacing=12 と階層的に整合）
    -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource ViewGridCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ViewGridCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--
        P1: SubtleCard（カード感を弱めたバージョン）。
        Border は無し、背景の色だけで「セクション分け」を表現する。
        Card よりさらに密度を上げたい場面（リスト項目の背景など）で使う。
    -->
    <Style Selector="Border.SubtleCard">
        <Setter Property="Background" Value="{DynamicResource ViewGridCardBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- フォーム内 1 セクション（ラベル + 入力 1 行）。Spacing 4 → 6 で行間に呼吸感 -->
    <Style Selector="StackPanel.FormSection">
        <Setter Property="Spacing" Value="6" />
    </Style>

    <!-- フォームのセクション群。Spacing 12 → 16 で各セクション（回転 / 反転 / スケーリング 等）が
         明確に分離して見え、密度の高い特性編集タブの窮屈感を緩和する -->
    <Style Selector="StackPanel.FormGroup">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <!--
        ツールバーボタン（編集メニュー横の Undo / 履歴 / Redo 等）。
        ・透明背景 + hover で薄い背景色（FluentTheme のシステム色を流用）。
        ・disabled 時は Opacity を下げてモノトーン化。
        ・固定幅 32×28 でツールバー上で揃う。
    -->
    <Style Selector="Button.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
    </Style>
    <Style Selector="Button.toolbar:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!--
        破壊操作 (削除など) 用のリンク風ボタン。 通常時は控えめなテキストリンク見え、
        hover で薄い赤背景、 pressed でやや濃い赤背景。 アクセント色 (緑/青等の
        ポジティブ) と区別して 「危険操作」 を視覚化する。 配置を削除 / グリッド削除 /
        論理コピー削除確認等で使う。 元は GridWorkspaceView ローカル定義だったが、
        全 View で再利用するため CommonStyles へ昇格。
    -->
    <Style Selector="Button.dangerLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
    <Style Selector="Button.dangerLink:pointerover /template/ ContentPresenter">
        <!-- 薄い赤の hover 背景 (alpha 0x1A = 約 10%)、 危険操作と分かる程度 -->
        <Setter Property="Background" Value="#1AFF3333" />
        <Setter Property="BorderBrush" Value="#33FF3333" />
    </Style>
    <Style Selector="Button.dangerLink:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF3333" />
        <Setter Property="BorderBrush" Value="#66FF3333" />
    </Style>
    <Style Selector="Button.dangerLink:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!--
        P2: 主要 TabControl（準備 / 配置）のヘッダ強化。
        FluentTheme の既定だとフォントが本文と同じで「タブ」に見えにくい。
        ・FontSize 16、SemiBold で大きく見せる
        ・Padding を上下 10 に拡げてクリック領域を広く
        ・選択中はアクセント色のアンダーラインを太くして「現在のフェーズ」を示す
        ・ステッパー風の workflow を表現
    -->
    <Style Selector="TabControl.MainTabs > TabItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="TabControl.MainTabs > TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>

    <!--
        P5: ステータスバー。最下部に固定で 1 行、高さ 24、薄い境界線、
        SystemBaseLowColor 背景で本体と区別する。FontSize 11 で控えめに。
    -->
    <Style Selector="Border.StatusBar">
        <Setter Property="Background" Value="{DynamicResource ViewGridCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ViewGridCardBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.StatusBarText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        永続ヒントバー（ステータスバー直上）。コンテキスト依存のショートカット案内を 1 行で表示。
        StatusBar より一段背景色を強めにしてバー間の視覚分離を出すが、
        本文 (キャンバス) より控えめな配色を維持。空文字なら View 側で IsVisible=False に折り畳む。
    -->
    <Style Selector="Border.HintStripe">
        <Setter Property="Background" Value="{DynamicResource SystemAltMediumLowColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ViewGridCardBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.HintStripeText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        P6: アイコン + テキストのボタン（「+ 新規」「削除」など）。
        PathIcon を左、TextBlock を右に並べたコンテンツ用。Spacing は CommonStyles の 1 単位。
    -->
    <Style Selector="StackPanel.IconButtonContent">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <!--
        P6: アイコン + テキスト主要操作のアウトライン強調。
        FluentTheme の Classes="accent" は Background をアクセント色で塗りつぶすため、
        PathIcon + TextBlock を内包する主要操作には派手すぎる。
        iconAccent は BorderBrush + Foreground でアクセント色を載せ、
        Background は idle 透明 → hover で薄く色を載せるアウトラインボタン系統。
        PathIcon は親 Button の Foreground を継承して同色に染まる。
    -->
    <Style Selector="Button.iconAccent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.iconAccent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.iconAccent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.iconAccent:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!--
        P6: 破壊操作のアウトライン版。 dangerLink は idle BorderBrush 透明で
        「テキストリンク」 の主張だが、 アイコン + テキスト主要操作と並ぶ場合は
        BorderBrush も常時赤色で 「ボタン感」 を残しつつ危険を視覚化する。
        hover/pressed 背景は dangerLink と同じ HEX 値を踏襲。
    -->
    <Style Selector="Button.iconDanger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
    <Style Selector="Button.iconDanger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFF3333" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
    <Style Selector="Button.iconDanger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF3333" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
    <Style Selector="Button.iconDanger:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
</Styles>
