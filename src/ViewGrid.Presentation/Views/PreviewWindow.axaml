<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:ViewGrid.Presentation.Localization"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="ViewGrid.Presentation.Views.PreviewWindow"
        Title="{loc:Tr Preview_Title}"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="900" Height="680"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <!--
            上部ズームツールバー: ManualCropEditorWindow と統一した操作体系
            (− / フィット / 100% / ＋ + 現在倍率)。 「実寸表示」という独自呼称は
            ユーザー視点で印刷サイズと混同しやすいので「100%」に統一。
            初期表示は常にフィット (出力プレビューを開いた瞬間にまず全体構図を確認、
            細部は 100% に切替 の流れ)。 フィット / 100% は ToggleButton で現在モードを
            ハイライト表示し、 ZoomLabel と合わせて状態が読み取りやすくする。
        -->
        <Grid Grid.Row="0" Margin="12,12,12,6" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Preview_Zoom}" VerticalAlignment="Center" />
                <Button x:Name="ZoomOutButton" Content="−" MinWidth="32"
                        Click="OnZoomOutClicked" ToolTip.Tip="{loc:Tr Preview_ZoomOut_Tooltip}" />
                <ToggleButton x:Name="ZoomFitButton" Content="{loc:Tr Preview_ZoomFit}"
                              Click="OnZoomFitClicked" ToolTip.Tip="{loc:Tr Preview_ZoomFit_Tooltip}" />
                <ToggleButton x:Name="Zoom100Button" Content="100%"
                              Click="OnZoom100Clicked" ToolTip.Tip="{loc:Tr Preview_Zoom100_Tooltip}" />
                <Button x:Name="ZoomInButton" Content="＋" MinWidth="32"
                        Click="OnZoomInClicked" ToolTip.Tip="{loc:Tr Preview_ZoomIn_Tooltip}" />

                <!--
                    倍率の入力 + プリセット選択を 1 つの枠に兼ねる (MS ペイント方式)。
                    Avalonia の ComboBox は編集不可のため、 TextBox + ▾ドロップダウンボタンの複合で実現。
                    1600% 等の高倍率へ「＋連打」せず 1 操作で到達できる。 −/＋/Ctrl+ホイールも併用可。
                    数値は確定時 (Enter / フォーカス喪失) に自前パースし、 ブランクや不正文字は黙って
                    現在値へ戻す (例外メッセージを出さない)。
                -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="3"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ZoomTextBox"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,3"
                                 MinWidth="52"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="100%"
                                 GotFocus="OnZoomTextGotFocus"
                                 KeyDown="OnZoomTextKeyDown"
                                 LostFocus="OnZoomTextLostFocus"
                                 ToolTip.Tip="{loc:Tr Preview_ZoomPercent_Tooltip}" />
                        <Button x:Name="ZoomDropdownButton"
                                Grid.Column="1"
                                Content="▾"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="6,0"
                                VerticalAlignment="Stretch"
                                ToolTip.Tip="{loc:Tr Preview_ZoomPreset_Tooltip}" />
                    </Grid>
                </Border>

                <!-- 縮小マップ表示トグル: 拡大時に自動表示、 ここで明示的に隠せる -->
                <ToggleButton x:Name="MapToggleButton"
                              Content="{loc:Tr Preview_Map}"
                              IsChecked="True"
                              Margin="8,0,0,0"
                              IsCheckedChanged="OnMapToggleChanged"
                              ToolTip.Tip="{loc:Tr Preview_Map_Tooltip}" />
            </StackPanel>
            <TextBlock x:Name="InfoText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Opacity="0.7"
                       FontSize="11" />
        </Grid>

        <!--
            メイン: ScrollViewer + Container Grid + Image。
            Image は Stretch=Fill で常に明示 Width/Height (= pixelSize × zoom / RenderScaling)
            に従って描画され、 ズーム値を一意に表現する。 Image を直接 ScrollViewer の
            Content にせず Container Grid を挟むのは、 拡大時 (Image > ScrollViewer 領域) は
            Container も同サイズで Extent を ScrollViewer に伝えてスクロールバーを発生させ、
            縮小時 (Image < ScrollViewer 領域) は Container の HorizontalAlignment=Center /
            VerticalAlignment=Center で画像を中央寄せにするため。
        -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                Margin="12,6,12,6">
            <Grid>
                <ScrollViewer x:Name="PreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Cursor="Hand">
                    <Grid x:Name="PreviewContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="8">
                        <Image x:Name="PreviewImage" Stretch="Fill" />
                    </Grid>
                </ScrollViewer>

                <!--
                    縮小マップ (ナビゲータ): 画像が表示領域をはみ出す拡大時のみ右下に重ねて表示。
                    MinimapImage は全体像、 MinimapViewport は現在の可視範囲を示す枠。
                    クリック / ドラッグで該当位置へスクロールする (ハンドラは MinimapRoot)。
                -->
                <Border x:Name="MinimapPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Padding="2"
                        IsVisible="False"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1"
                        Background="#B0202020"
                        BoxShadow="0 2 8 0 #80000000">
                    <Grid x:Name="MinimapRoot" Background="Transparent" Cursor="Hand">
                        <Image x:Name="MinimapImage" Stretch="Fill" />
                        <Canvas x:Name="MinimapCanvas" IsHitTestVisible="False">
                            <Border x:Name="MinimapViewport"
                                    BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="2"
                                    Background="#30FFFFFF" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="12,6,12,12"
              ColumnDefinitions="*,Auto,Auto">
            <!-- 左側はスペーサー (情報は上部に移動済み) -->
            <Button x:Name="SaveButton"
                    Grid.Column="1"
                    Content="{loc:Tr Preview_SaveAsPng}"
                    Classes="accent"
                    Margin="0,0,8,0"
                    Click="OnSaveClicked" />
            <Button Grid.Column="2"
                    Content="{loc:Tr Common_Close}"
                    Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
