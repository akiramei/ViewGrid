<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ViewGrid.Presentation.Views.GridWorkspaceView"
             x:Name="GridWorkspaceRoot"
             x:DataType="vm:GridWorkspaceViewModel">

    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="PathToBitmap" />
        <conv:TrimModeLabelConverter x:Key="TrimModeLabel" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,300">
        <!--
            中央: キャンバス。Grid 3 行構成で空状態案内とキャンバスを Row 1（*）に重ね、
            IsVisible で切替する。旧実装は DockPanel で Border に DockPanel.Dock 未指定 →
            既定の Left dock により空状態案内が左寄せで表示される問題があった。
            Row 1 の Stretch 領域内に StackPanel を Center/Center で置くことで、
            準備タブ (AssetLibraryView) の空状態と同じ視覚配置を保つ。
        -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0"
                    Padding="12,8"
                    IsVisible="{Binding HasGrid}">
                <StackPanel DataContext="{Binding CurrentGrid}"
                            x:DataType="vm:GridCanvasItemViewModel">
                    <TextBlock FontWeight="SemiBold" FontSize="14">
                        <Run Text="{Binding Name}" />
                        <Run Text=" — " />
                        <Run Text="{Binding GridSizeLabel}" />
                        <Run Text=" / " />
                        <Run Text="{Binding CanvasSizeLabel}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 空状態案内（HasGrid=false 時）。AssetLibraryView の「まだ画像がありません」と同じ
                 アイコン + 大見出し + 補足のレイアウトで視覚一貫性を保つ -->
            <Border Grid.Row="1"
                    IsVisible="{Binding !HasGrid}"
                    Padding="32">
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource LayoutGeometry}"
                              Width="48" Height="48"
                              Opacity="0.4"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="グリッドが選択されていません"
                               FontSize="16"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="左側の一覧から作成・選択してください"
                               FontSize="12"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <views:GridCanvasView Grid.Row="1"
                                  IsVisible="{Binding HasGrid}"
                                  Margin="12,0,12,12" />

            <!-- ステータスは高さ固定（テキスト有無で中央領域が伸縮するのを防ぐ） -->
            <Border Grid.Row="2"
                    Padding="12,4"
                    MinHeight="22">
                <TextBlock Text="{Binding StatusMessage}"
                           Opacity="0.7"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 右: 配置候補 + 操作。GridSplitter で「候補リスト」と「インスペクタ」を上下分割 -->
        <Border Grid.Column="1"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <Grid RowDefinitions="Auto,3*,Auto,4*">

                <!-- Row 0: ヘッダと操作ボタン群（固定高さ） -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Classes="SectionHeader"
                               Text="配置元（バリアント）" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="配置"
                                Command="{Binding PlaceSelectedToFirstFreeCellCommand}"
                                IsEnabled="{Binding SelectedCandidate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Classes="accent" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviewButton"
                                Content="プレビュー"
                                Click="OnPreviewClicked"
                                IsEnabled="{Binding HasGrid}" />
                        <Button Content="PNG 出力"
                                Command="{Binding ExportToPngCommand}"
                                IsEnabled="{Binding HasGrid}" />
                    </StackPanel>
                    <!--
                        プレビューと PNG 出力の両方に適用される共通トリミング設定。
                        None: キャンバス全面 / OccupiedCells: 占有セル bbox / DrawnPixels: α>0 の bbox
                    -->
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="FieldLabel" Text="トリム" />
                        <ComboBox ItemsSource="{Binding TrimModeOptions}"
                                  SelectedItem="{Binding SelectedTrimMode}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="プレビューと PNG 出力で適用">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TrimModeLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Separator />
                </StackPanel>

                <!-- Row 1: 候補リスト（伸縮可、最低 120px） -->
                <ListBox x:Name="CandidateList"
                         Grid.Row="1"
                         MinHeight="120"
                         ItemsSource="{Binding Candidates}"
                         SelectedItem="{Binding SelectedCandidate}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CopyCandidateViewModel">
                            <Grid ColumnDefinitions="48,*" Margin="2" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        Width="48" Height="48"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        CornerRadius="3">
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AssetFilename}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CopyDisplayName}" FontSize="10" Opacity="0.7" />
                                    <TextBlock Text="{Binding SummaryLine}" FontSize="10" Opacity="0.55" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 2: 上下分割スプリッター -->
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              Background="{DynamicResource SystemBaseLowColor}"
                              Margin="0,4" />

                <!--
                    Row 3: 文脈依存プロパティパネル（伸縮可、最低 160px）。
                    CurrentSelection (ISelectionContext) の派生フラグで 3 状態を切替:
                      ・PlacementSelection → PlacementInspectorView（配置固有プロパティ + 共有編集ナビ）
                      ・GridSelection → GridPropertiesView（グリッド名 / サイズ / 比率の読み取り専用）
                      ・NoSelection → 「グリッドを選択してください」案内
                    将来 3 ペイン化するときは ContentControl + DataTemplates ベースに移行する。
                -->
                <DockPanel Grid.Row="3" MinHeight="160" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="11"
                               Opacity="0.75"
                               Margin="0,0,0,4"
                               IsVisible="{Binding HasGrid}">
                        <Run Text="配置済み:" />
                        <Run Text="{Binding Placements.Count}" />
                        <Run Text="件" />
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                        <Button Content="配置を削除"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RemoveSelectedPlacementCommand}"
                                IsEnabled="{Binding IsPlacementSelected}" />
                        <ProgressBar Height="3"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}" />
                    </StackPanel>

                    <!--
                        子 View の DataContext を切り替えると IsVisible バインドも子側で解決されてしまうため、
                        IsVisible の参照は ElementName=GridWorkspaceRoot 経由で親 VM
                        (GridWorkspaceViewModel) のフラグを明示的に指す。
                    -->
                    <!-- 配置選択中: 既存の Inspector を表示 -->
                    <views:PlacementInspectorView DataContext="{Binding Inspector}"
                                                  IsVisible="{Binding #GridWorkspaceRoot.DataContext.IsPlacementSelected}" />

                    <!-- グリッドのみ選択中（配置未選択）: グリッド情報を表示 -->
                    <views:GridPropertiesView DataContext="{Binding CurrentGrid}"
                                              IsVisible="{Binding #GridWorkspaceRoot.DataContext.IsGridOnlySelected}" />

                    <!-- グリッド未選択: 案内 -->
                    <Border IsVisible="{Binding IsNoSelection}"
                            Padding="12">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="グリッドを選択してください"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="左の一覧から作成・選択するとプロパティが表示されます"
                                       Opacity="0.5"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DockPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
