<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
             xmlns:controls="clr-namespace:ViewGrid.Presentation.Controls"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ViewGrid.Presentation.Views.GridWorkspaceView"
             x:Name="GridWorkspaceRoot"
             x:DataType="vm:GridWorkspaceViewModel">

    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="PathToBitmap" />
        <conv:TrimModeLabelConverter x:Key="TrimModeLabel" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!--
            スタイルカード: 未選択は透明背景 + 細い灰色枠、 hover で薄く色がつき、
            選択中だけアクセント色の太枠で目立たせる。 全カードを濃いグレーにしないことで
            視線がアクセントカードに自然に向かう。
        -->
        <Style Selector="ToggleButton.StyleCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="ToggleButton.StyleCard /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.StyleCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
        </Style>
        <Style Selector="ToggleButton.StyleCard:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <!-- FluentTheme の :checked 既定は Foreground=White (= 文字色をアクセント面の上で
                 反転させる) だが、 StyleCard では背景透過のままなので白文字 = 白背景に消える。
                 通常文字色に戻し、 選択状態は枠とサムネだけで表現する。 -->
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
        </Style>
        <Style Selector="ToggleButton.StyleCard:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
        </Style>
        <!-- 念のため :pressed 状態の Foreground も同じに揃える (押下中の白文字フラッシュ回避) -->
        <Style Selector="ToggleButton.StyleCard:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
        </Style>
        <Style Selector="ToggleButton.StyleCard:checked:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
        </Style>

        <!--
            出力モードのセグメント (隣接 2 ボタンを横幅いっぱいに連結、 segmented control 風)。
            未選択は白地 + 細枠で「裏側のオプション」感を出し、 選択中だけアクセント色面で
            「現在のモード」を強調する。 これでカード全体の重さを抑えつつ二択を表現。
        -->
        <Style Selector="ToggleButton.Segment">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="ToggleButton.Segment /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.Segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
        </Style>
        <Style Selector="ToggleButton.Segment:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="ToggleButton.Segment:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!--
            「既定に戻す」専用ボタン。 toolbar クラスの :disabled が Opacity=0.4 で
            少し薄すぎ「ここにリセットがある」のが見えにくいフィードバックがあったため、
            disabled でも 0.55 で文字が読める程度に残す。 hover / 押下挙動は toolbar と同じ。
        -->
        <Style Selector="Button.resetIntensity">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.resetIntensity:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
        </Style>
        <Style Selector="Button.resetIntensity:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Styles>

    <!--
        配置タブの本体を 3 ペイン構造に再編:
        ・Column 0 (320px): 配置元（バリアント）リストを大きく表示。「配置」「プレビュー」「PNG 出力」
          「トリム」操作も同居（旧右ペイン上部から移動）。
        ・Column 1 (*): 中央キャンバス（タイトル / GridCanvasView / ステータス、旧 Column 0 の構造維持）。
        ・Column 2 (300px): プロパティパネル（ISelectionContext 駆動、旧右ペイン下部）。
          「配置済み」要約 / 「配置を削除」ボタンも同居。
        旧構造（中央 + 右ペイン 300px に候補とプロパティを混在）から、候補とプロパティを左右に分離する形。
    -->
    <Grid ColumnDefinitions="320,*,380">

        <!--
            Column 0: 配置元（バリアント）リスト + 操作ボタン。
            旧 Column 1 (Row 0+1) を独立したペインとして抽出し、サムネが視認しやすい広さに。
        -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,0,1,0"
                Padding="12">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                    <!--
                        配置ファースト UI 第 2 段階 (Stage 1): 画像追加を配置タブから直接できるように。
                        ファイルピッカーは AssetLibrary.PickFilesAndImportCommand を経由する。
                        DataContext は GridWorkspaceViewModel のため、親 Window 経由で
                        MainWindowViewModel.AssetLibrary に到達する RelativeSource バインディング。
                        D&D は MainWindow 全体で受けて AssetLibrary.AddFilesAsync に流れるので
                        既に動作中（タブ非依存）。
                    -->
                    <Button Content="+ 画像を追加"
                            HorizontalAlignment="Stretch"
                            Classes="accent"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AssetLibrary.PickFilesAndImportCommand}"
                            ToolTip.Tip="ファイルから画像を取り込みます（ドラッグ&amp;ドロップでも追加可）" />
                    <TextBlock Classes="SectionHeader"
                               Text="配置元（バリアント）" />

                    <!--
                        操作対象（バリアント / グリッド）でグループ分けする原則に従い、
                        「配置」「新規バリアント」「削除」をバリアント操作グループにまとめる。
                        プレビュー / PNG 出力 / トリムはグリッド全体への操作なので
                        中央キャンバス上ヘッダへ移動済み。
                        F2 / ダブルクリックでインラインリネーム、Delete キーは ListBox 上で扱う。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding !IsCreatingVariant}">
                        <Button Content="配置"
                                Command="{Binding PlaceSelectedToFirstFreeCellCommand}"
                                IsEnabled="{Binding SelectedCandidate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Classes="accent"
                                ToolTip.Tip="選択中のバリアントを最初の空きセルに配置します" />
                        <Button Command="{Binding BeginCreateVariantCommand}"
                                ToolTip.Tip="選択中バリアントと同じアセットから新規バリアントを作成">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource AddGeometry}" Width="14" Height="14" />
                                <TextBlock Text="新規バリアント" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectedCandidateCommand}"
                                ToolTip.Tip="選択中バリアントを削除（関連配置も削除されます）">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource DeleteGeometry}" Width="14" Height="14" />
                                <TextBlock Text="削除" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 新規作成フライアウト: 名前入力 + 作成/キャンセル -->
                    <Border IsVisible="{Binding IsCreatingVariant}"
                            Padding="8"
                            Background="{DynamicResource SystemAltMediumLowColor}"
                            CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="新規バリアント" FontWeight="SemiBold" />
                            <TextBox x:Name="DraftVariantNameBox"
                                     Text="{Binding DraftVariantName, Mode=TwoWay}"
                                     PlaceholderText="名前（空欄で「バリアント N」自動採番）">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitCreateVariantCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelCreateVariantCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Content="作成"
                                        Command="{Binding CommitCreateVariantCommand}"
                                        IsDefault="True" />
                                <Button Content="キャンセル"
                                        Command="{Binding CancelCreateVariantCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--
                    バリアント候補リストを Asset でグループ化。各 Asset がグループヘッダ、
                    その配下に CopyCandidateViewModel が並ぶ 2 階層 TreeView。
                    SelectedItem は CopyCandidateViewModel のみ受け付ける（Group ヘッダクリック時は
                    型不一致で SelectedCandidate は変更されない）。
                    既存の D&D / インラインリネーム / F2 / DoubleTapped は CodeBehind が
                    TreeViewItem.DataContext の型を見て CopyCandidateViewModel のときだけ反応する。
                -->
                <TreeView x:Name="CandidateTree"
                          Grid.Row="1"
                          ItemsSource="{Binding CandidateGroups}"
                          SelectedItem="{Binding SelectedCandidate}"
                          DoubleTapped="OnCandidateListDoubleTapped"
                          KeyDown="OnCandidateListKeyDown"
                          Background="Transparent">
                    <!--
                        TreeViewItem.IsExpanded を VM 側 (CandidateGroupViewModel.IsExpanded) に
                        TwoWay バインドする。これにより候補ライブラリの再ロード時（Save 後の
                        CopyLibraryChangedMessage 経由）でもグループの展開状態が保持される。
                        葉ノード (CopyCandidateViewModel) も同名プロパティを持っているので
                        バインドエラーは出ない。
                        Style 内バインドはコンパイル時に DataContext 型が解決できない
                        （UserControl の x:DataType=GridWorkspaceViewModel と取り違えて AVLN2000）。
                        ReflectionBinding でランタイム解決に切り替える。
                    -->
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:CandidateGroupViewModel"
                                          ItemsSource="{Binding Variants}">
                            <!--
                                グループヘッダの右クリックでアセット削除メニューを開く。
                                ContextMenu の DataContext は親（TreeViewItem の DataContext = CandidateGroupViewModel）
                                を引き継ぐので、Click で渡される sender / DataContext から
                                対象 AssetId と件数を取り出せる。
                            -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="6">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="アセットを削除..."
                                                  Click="OnDeleteAssetClicked" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding AssetFilename}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SummaryLine}"
                                           FontSize="11"
                                           Opacity="0.6" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.DataTemplates>
                        <DataTemplate DataType="vm:CopyCandidateViewModel">
                            <Grid ColumnDefinitions="64,*" Margin="2,4" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="64" Height="64"
                                        Background="{DynamicResource SystemChromeMediumLowColor}"
                                        CornerRadius="4">
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <!-- 通常表示: TextBlock。F2 / ダブルクリックで編集モードに切替 -->
                                    <TextBlock Text="{Binding CopyDisplayName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding !IsEditing}" />
                                    <!--
                                        編集モード: 標準 TextBox + FocusOnVisible Attached Property。
                                        IsVisible が false → true に転じた瞬間に Focus + SelectAll を
                                        DispatcherPriority.Loaded でポストする（実型一致スタイルの罠を
                                        避けるためサブクラス化はしない）。Enter / フォーカス喪失で確定、
                                        Esc でキャンセル。
                                    -->
                                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                             FontSize="12"
                                             IsVisible="{Binding IsEditing}"
                                             PlaceholderText="（空欄で「既定」表示）"
                                             controls:FocusOnVisible.IsEnabled="True"
                                             KeyDown="OnEditingCandidateKeyDown"
                                             LostFocus="OnEditingCandidateLostFocus" />
                                    <TextBlock Text="{Binding SummaryLine}"
                                               FontSize="10"
                                               Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Grid>
        </Border>

        <!--
            Column 1: 中央キャンバス。Grid 3 行構成で空状態案内とキャンバスを Row 1（*）に重ね、
            IsVisible で切替する。旧実装は DockPanel で Border に DockPanel.Dock 未指定 →
            既定の Left dock により空状態案内が左寄せで表示される問題があった。
            Row 1 の Stretch 領域内に StackPanel を Center/Center で置くことで、
            準備タブ (AssetLibraryView) の空状態と同じ視覚配置を保つ。
        -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <!--
                グリッド全体への操作（プレビュー / PNG 出力 / トリム設定）を上ヘッダの右側に集約。
                これらは「アクティブグリッドのレンダリング」が対象なので、バリアント操作（左ペイン）と
                空間的に分離する。トリム ComboBox は MinWidth で必要十分な幅を確保し、
                ラベルは ToolTip と placeholder 的に省略してヘッダ内のスペースを節約。
            -->
            <Border Grid.Row="0"
                    Padding="12,8"
                    IsVisible="{Binding HasGrid}">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- DataContext と x:DataType を同要素に書くと Avalonia の compile-time
                         binding が DataContext バインディングそのものを内側 DataType 上で
                         解決しようとして CurrentGrid が見つからない警告が出る。子要素に
                         x:DataType を移動して、外側は親の型 (GridWorkspaceViewModel) で
                         CurrentGrid を解決させる。 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                DataContext="{Binding CurrentGrid}">
                        <!--
                            表示モード: グリッド名 + サマリ。ダブルクリックで TextBox に切替。
                            Cursor=IBeam で「編集可能」をユーザーに示す。
                        -->
                        <TextBlock x:Name="GridTitleText"
                                   FontWeight="SemiBold" FontSize="14"
                                   x:DataType="vm:GridCanvasItemViewModel"
                                   IsVisible="{Binding !IsEditing}"
                                   Cursor="IBeam"
                                   ToolTip.Tip="ダブルクリックで名前を変更"
                                   DoubleTapped="OnGridTitleDoubleTapped">
                            <Run Text="{Binding Name}" />
                            <Run Text=" — " />
                            <Run Text="{Binding GridSizeLabel}" />
                            <Run Text=" / " />
                            <Run Text="{Binding CanvasSizeLabel}" />
                        </TextBlock>
                        <!--
                            編集モード: 名前部分のみ TextBox に切替、サマリは右側に薄く残す。
                            Enter で確定 / Esc でキャンセル / フォーカス喪失で確定 (CodeBehind ハンドラ)。
                        -->
                        <TextBox x:Name="GridTitleEditor"
                                 x:DataType="vm:GridCanvasItemViewModel"
                                 IsVisible="{Binding IsEditing}"
                                 Text="{Binding EditingName}"
                                 FontWeight="SemiBold" FontSize="14"
                                 MinWidth="200"
                                 KeyDown="OnGridTitleEditorKeyDown"
                                 LostFocus="OnGridTitleEditorLostFocus" />
                        <TextBlock x:DataType="vm:GridCanvasItemViewModel"
                                   IsVisible="{Binding IsEditing}"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   FontSize="11">
                            <Run Text=" — " />
                            <Run Text="{Binding GridSizeLabel}" />
                            <Run Text=" / " />
                            <Run Text="{Binding CanvasSizeLabel}" />
                        </TextBlock>
                    </StackPanel>
                    <!--
                        中央ヘッダはグリッド名 + 出力アクション (プレビュー / PNG 出力) のみに縮約。
                        出力モード / スタイル / 強度 / 切り出しの設定はすべて右ペイン上部の
                        「出力設定」パネルに集約済み。 PNG 出力は主要アクションなので accent。
                    -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <Button x:Name="PreviewButton"
                                Content="プレビュー"
                                Click="OnPreviewClicked"
                                IsEnabled="{Binding HasGrid}" />
                        <Button Content="PNG 出力"
                                Classes="accent"
                                Command="{Binding ExportToPngCommand}"
                                IsEnabled="{Binding HasGrid}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 空状態案内（HasGrid=false 時）。AssetLibraryView の「まだ画像がありません」と同じ
                 アイコン + 大見出し + 補足のレイアウトで視覚一貫性を保つ -->
            <Border Grid.Row="1"
                    IsVisible="{Binding !HasGrid}"
                    Padding="32">
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource LayoutGeometry}"
                              Width="48" Height="48"
                              Opacity="0.4"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="グリッドが選択されていません"
                               FontSize="16"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="左側の一覧から作成・選択してください"
                               FontSize="12"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <views:GridCanvasView Grid.Row="1"
                                  IsVisible="{Binding HasGrid}"
                                  Margin="12,0,12,12" />

            <!-- ステータスは高さ固定（テキスト有無で中央領域が伸縮するのを防ぐ） -->
            <Border Grid.Row="2"
                    Padding="12,4"
                    MinHeight="22">
                <TextBlock Text="{Binding StatusMessage}"
                           Opacity="0.7"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!--
            Column 2: プロパティパネル。ISelectionContext (CurrentSelection) 駆動で 3 状態を切替。
            「配置済み」要約と「配置を削除」操作も同居（旧右ペイン下部の構造を継承）。
            旧 Column 1 (300px) に混在していた候補リストは Column 0 へ分離した。
        -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1,0,0,0"
                Padding="8">
            <!--
                旧版は DockPanel に PlacementInspectorView / GridPropertiesView / 空状態 Border を
                直接並べ「LastChildFill=true で最後の子が伸縮」する設計だった。しかし DockPanel の
                子に <c>DockPanel.Dock</c> 未指定の場合は<b>既定で Dock=Left</b>として扱われ、
                PlacementInspectorView は preferred width しか取れず右側に大きな余白が残っていた。
                Grid RowDefinitions=Auto,*,Auto に変更し、中央行 (*) に Grid を重ねて 3 状態の
                View を同じセルに置くことで、IsVisible=true の View が必ず幅一杯まで伸縮する。
            -->
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           FontSize="11"
                           Opacity="0.75"
                           Margin="0,0,0,8"
                           IsVisible="{Binding HasGrid}">
                    <Run Text="配置済み:" />
                    <Run Text="{Binding Placements.Count}" />
                    <Run Text="件" />
                </TextBlock>

                <!--
                    出力設定パネル: HasGrid のときのみ表示。 4 セクション
                    (出力モード / スタイル / 調整 / 切り出し) で情報の階層を明確化。
                    旧実装は中央ヘッダ右側に詰め込んでいたが、 最小ウィンドウ幅で破綻しやすく、
                    かつ chaos スライダーの数値が露出していてユーザーに意味が伝わらない問題があった。
                    効果ベースのラベル + 視覚サンプル + リセット手段で再構成。
                -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasGrid}"
                        Padding="8"
                        Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Spacing="14">
                        <!-- ─── 出力モード: 横幅いっぱいの segmented control ─── -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="出力モード" Classes="SectionHeader" />
                            <Grid ColumnDefinitions="*,*">
                                <ToggleButton Grid.Column="0"
                                              Classes="Segment"
                                              Content="通常"
                                              IsChecked="{Binding IsNormalMode, Mode=OneWay}"
                                              Command="{Binding SelectOutputModeNormalCommand}"
                                              ToolTip.Tip="グリッドのセル配置をそのままレンダリングします" />
                                <ToggleButton Grid.Column="1"
                                              Classes="Segment"
                                              Content="写真ボード"
                                              IsChecked="{Binding IsPhotoBoardMode, Mode=OneWay}"
                                              Command="{Binding SelectOutputModePhotoBoardCommand}"
                                              ToolTip.Tip="フレーム + 影 + ジッターで写真ボード風に再合成します" />
                            </Grid>
                        </StackPanel>

                        <!-- ─── スタイル (PhotoBoard 時のみ) ─── -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsPhotoBoardMode}">
                            <TextBlock Text="スタイル" Classes="SectionHeader" />
                            <StackPanel Spacing="4">
                                <!-- ナチュラル -->
                                <ToggleButton Classes="StyleCard"
                                              IsChecked="{Binding IsStyleNatural, Mode=OneWay}"
                                              Command="{Binding ApplyPhotoBoardStyleNaturalCommand}"
                                              ToolTip.Tip="軽い揺らぎ・整然とした配置 (写真アルバム風)">
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                        <!-- フォントの SemiBold 文字は視覚重心が下寄りになるため、
                                             サンプル Canvas を 1px だけ下げて視覚中心を文字側と揃える。 -->
                                        <Canvas Grid.Column="0" Width="64" Height="40"
                                                VerticalAlignment="Center"
                                                Margin="0,1,0,0">
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="6" Canvas.Top="5"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-2" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="36" Canvas.Top="3"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="1" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="8" Canvas.Top="22"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="3" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="38" Canvas.Top="23"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-1" /></Border.RenderTransform>
                                            </Border>
                                        </Canvas>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="ナチュラル" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                            <TextBlock Text="軽い揺らぎ・整然" Classes="HintText" FontSize="10"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                        </StackPanel>
                                    </Grid>
                                </ToggleButton>

                                <!-- ラフ -->
                                <ToggleButton Classes="StyleCard"
                                              IsChecked="{Binding IsStyleRough, Mode=OneWay}"
                                              Command="{Binding ApplyPhotoBoardStyleRoughCommand}"
                                              ToolTip.Tip="中程度の回転・たまの重なり (ノートに貼った写真風)">
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                        <!-- フォントの SemiBold 文字は視覚重心が下寄りになるため、
                                             サンプル Canvas を 1px だけ下げて視覚中心を文字側と揃える。 -->
                                        <Canvas Grid.Column="0" Width="64" Height="40"
                                                VerticalAlignment="Center"
                                                Margin="0,1,0,0">
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="4" Canvas.Top="6"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-8" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="32" Canvas.Top="3"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="5" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="10" Canvas.Top="22"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="7" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="38" Canvas.Top="24"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-5" /></Border.RenderTransform>
                                            </Border>
                                        </Canvas>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="ラフ" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                            <TextBlock Text="中程度の傾き・少しの重なり" Classes="HintText" FontSize="10"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                        </StackPanel>
                                    </Grid>
                                </ToggleButton>

                                <!-- バラ撒き -->
                                <ToggleButton Classes="StyleCard"
                                              IsChecked="{Binding IsStyleScattered, Mode=OneWay}"
                                              Command="{Binding ApplyPhotoBoardStyleScatteredCommand}"
                                              ToolTip.Tip="大胆な回転・頻繁な重なり (机にぶちまけた写真風)">
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                        <!-- フォントの SemiBold 文字は視覚重心が下寄りになるため、
                                             サンプル Canvas を 1px だけ下げて視覚中心を文字側と揃える。 -->
                                        <Canvas Grid.Column="0" Width="64" Height="40"
                                                VerticalAlignment="Center"
                                                Margin="0,1,0,0">
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="2" Canvas.Top="8"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-14" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="22" Canvas.Top="2"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="10" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="42" Canvas.Top="12"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-8" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="6" Canvas.Top="24"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="12" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="20" Height="14" Background="White"
                                                    BorderBrush="#888" BorderThickness="1"
                                                    Canvas.Left="30" Canvas.Top="22"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
                                            </Border>
                                        </Canvas>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="バラ撒き" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                            <TextBlock Text="大胆な傾き・複数の重なり" Classes="HintText" FontSize="10"
                                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                                        </StackPanel>
                                    </Grid>
                                </ToggleButton>
                            </StackPanel>

                        </StackPanel>

                        <!-- ─── 調整: 配置の乱れスライダー (PhotoBoard 時のみ) ─── -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsPhotoBoardMode}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="調整" Classes="SectionHeader" />
                                <!-- スライダーは正確に中央 (既定値) へ戻すのが難しいので
                                     明示的なリセット手段。 ↺ アイコンで「ボタンである」操作可能性を
                                     強調し、 既定位置 (intensity=0.5) のときは CanExecute=false で
                                     自動的に dim される (resetIntensity スタイルの :disabled で
                                     Opacity=0.55、 toolbar の 0.4 より少し濃く読みやすく)。 -->
                                <Button Grid.Column="1"
                                        Classes="resetIntensity"
                                        Command="{Binding ResetPhotoBoardIntensityCommand}"
                                        ToolTip.Tip="配置の乱れを既定値 (中央) に戻します">
                                    <!-- アイコン + 文字を同じ行内ベースラインで揃えると ↺ Unicode は
                                         日本語より高く見えがち。 PathIcon (RefreshGeometry) で
                                         pixel-perfect な高さ + VerticalAlignment=Center で揃える。 -->
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource RefreshGeometry}"
                                                  Width="11" Height="11"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="既定に戻す"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="控えめ" Classes="HintText"
                                           FontSize="11" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                        TickFrequency="0.1"
                                        Value="{Binding SelectedPhotoBoardIntensity}"
                                        ToolTip.Tip="選んだスタイルの強度を控えめ ↔ 大胆 で調整します" />
                                <TextBlock Grid.Column="2" Text="大胆" Classes="HintText"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- ─── 切り出し: 通常モードでも PhotoBoard モードでも常に表示 ─── -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="切り出し" Classes="SectionHeader" />
                            <ComboBox ItemsSource="{Binding TrimModeOptions}"
                                      SelectedItem="{Binding SelectedTrimMode}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="出力 PNG の切り出し範囲。 PhotoBoard 時も合成後の画像に同じセマンティクスで適用されます。">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TrimModeLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 既存パネルは Row=2 (Auto separator) と Row=3 (* contextual) と Row=4 (Auto actions) に下げる。
                     ここでは Row 2 (区切り) は付けず、Border 自身の枠で十分視覚分離している。 -->
                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource SystemBaseLowColor}"
                        Margin="0,0,0,8"
                        IsVisible="{Binding HasGrid}" />

                <!--
                    子 View の DataContext を切り替えると IsVisible バインドも子側で解決されてしまうため、
                    IsVisible の参照は ElementName=GridWorkspaceRoot 経由で親 VM
                    (GridWorkspaceViewModel) のフラグを明示的に指す。
                -->
                <Grid Grid.Row="3">
                    <!-- 配置選択中: Inspector を表示（配置固有プロパティ + 共有特性編集 inline）。
                         ElementName 経由 DataContext は型 object なので明示キャストして
                         compile-time binding の警告を回避。 -->
                    <views:PlacementInspectorView DataContext="{Binding Inspector}"
                                                  IsVisible="{Binding #GridWorkspaceRoot.((vm:GridWorkspaceViewModel)DataContext).IsPlacementSelected}" />

                    <!-- グリッドのみ選択中（配置未選択）: グリッド情報を表示 -->
                    <views:GridPropertiesView DataContext="{Binding CurrentGrid}"
                                              IsVisible="{Binding #GridWorkspaceRoot.((vm:GridWorkspaceViewModel)DataContext).IsGridOnlySelected}" />

                    <!-- グリッド未選択: 案内 -->
                    <Border IsVisible="{Binding IsNoSelection}"
                            Padding="12">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="グリッドを選択してください"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="上のグリッド切替バーから作成・選択するとプロパティが表示されます"
                                       Opacity="0.5"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
                    <Button Content="配置を削除"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RemoveSelectedPlacementCommand}"
                            IsEnabled="{Binding IsPlacementSelected}" />
                    <ProgressBar Height="3"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
