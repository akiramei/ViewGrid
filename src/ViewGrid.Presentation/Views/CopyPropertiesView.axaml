<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
             x:Class="ViewGrid.Presentation.Views.CopyPropertiesView"
             x:DataType="vm:CopyPropertiesViewModel">

    <UserControl.Resources>
        <conv:ScalingModeLabelConverter x:Key="ScalingModeLabel" />
        <conv:AutoCropPresetLabelConverter x:Key="AutoCropPresetLabel" />
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmap" />
    </UserControl.Resources>

    <Border Padding="12">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Classes="SectionHeader"
                       Text="特性編集"
                       Margin="0,0,0,8" />

            <TextBlock DockPanel.Dock="Top"
                       Text="論理コピーを選択してください"
                       Opacity="0.55"
                       IsVisible="{Binding !HasCopy}" />

            <!-- マルチセレクト中の案内（編集は 1 件選択時のみ可能） -->
            <Border DockPanel.Dock="Top"
                    Classes="WarningBanner"
                    Margin="0,4,0,8"
                    IsVisible="{Binding MultiSelectMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding MultiSelectMessage}"
                           FontSize="12" />
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        Classes="accent" />
                <Button Content="リセット"
                        Command="{Binding RevertCommand}" />
                <TextBlock Text="*"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SystemAccentColor}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsDirty}"
                           ToolTip.Tip="未保存の変更があります" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,8,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!--
                項目数増加に伴うタブ分割。「特性」は変形・配置の既存項目（編集頻度高、既定タブ）、
                「トリミング」は AutoCrop 全体（サムネプレビューを必要なときに広く使える）。
                IsDirty 状態はタブ間で共有、保存/リセットは下部共通なので両タブを跨いで一括編集可能。
            -->
            <TabControl IsEnabled="{Binding HasCopy}">
                <TabItem Header="特性">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                        <StackPanel Classes="FormGroup">
                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="名前" />
                                <TextBox Text="{Binding CopyName}" PlaceholderText="（既定）" />
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="回転" />
                                <ComboBox ItemsSource="{Binding RotationOptions}"
                                          SelectedItem="{Binding Rotation}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="反転" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="水平 (H)" IsChecked="{Binding FlipX}" />
                                    <CheckBox Content="垂直 (V)" IsChecked="{Binding FlipY}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="スケーリング" />
                                <ComboBox ItemsSource="{Binding ScalingModeOptions}"
                                          SelectedItem="{Binding ScalingMode}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ScalingModeLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!--
                                Alignment: 単一アンカーで「画像 ≤ セル での配置位置」と
                                「画像 > セル での表示部分」を両方表現する（CSS background-position と同じ）。
                                Fill モードでは画像がセルにピッタリ伸縮されるため Alignment は効かない。
                            -->
                            <StackPanel Classes="FormSection" IsEnabled="{Binding IsAlignmentActive}">
                                <TextBlock Classes="FieldLabel" Text="アライメント" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AnchorXOptions}"
                                              SelectedItem="{Binding AlignX}"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AnchorYOptions}"
                                              SelectedItem="{Binding AlignY}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="占有セル (W×H)" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <NumericUpDown Grid.Column="0"
                                                   Value="{Binding OccupyWidth}"
                                                   Minimum="1" Maximum="20"
                                                   FormatString="0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding OccupyHeight}"
                                                   Minimum="1" Maximum="20"
                                                   FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--
                    単色余白の自動トリミング（外周走査）。画像の外周から「対象色＋閾値」に
                    一致するピクセルを矩形維持で削り、内側の絵柄領域だけをセルに収める。
                    スキャン画像の白/黒余白を物理コピーせずに切り落とすための機能。
                -->
                <TabItem Header="トリミング">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                        <StackPanel Classes="FormGroup">
                            <StackPanel Classes="FormSection">
                                <CheckBox Content="単色余白を自動トリミング"
                                          IsChecked="{Binding AutoCropEnabled}" />
                                <TextBlock Classes="HintText"
                                           Text="画像の外周から対象色を矩形維持で削り、内側だけをセルに収めます。" />
                            </StackPanel>

                            <StackPanel Classes="FormSection" IsEnabled="{Binding AutoCropEnabled}">
                                <TextBlock Classes="FieldLabel" Text="対象色" />
                                <ComboBox ItemsSource="{Binding AutoCropPresetOptions}"
                                          SelectedItem="{Binding AutoCropPreset}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AutoCropPresetLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- カスタム時の HEX 入力（#RRGGBB） + サムネクリックピッカー -->
                                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding IsAutoCropCustom}">
                                    <TextBlock Classes="FieldLabel" Text="HEX (#RRGGBB)" />
                                    <TextBox Text="{Binding AutoCropCustomColorHex}"
                                             PlaceholderText="#FFFFFF" />
                                    <TextBlock Classes="HintText"
                                               Text="サムネ画像をクリックすると色を採取できます。" />
                                    <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SystemAltMediumLowColor}"
                                            IsVisible="{Binding HasThumbnail}">
                                        <Image x:Name="ColorPickerImage"
                                               Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                               MaxHeight="240"
                                               Stretch="Uniform"
                                               Cursor="Cross"
                                               PointerPressed="OnColorPickerPointerPressed" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Classes="FormSection" IsEnabled="{Binding AutoCropEnabled}">
                                <TextBlock Classes="FieldLabel" Text="許容色差（0–128）" />
                                <NumericUpDown Value="{Binding AutoCropThreshold}"
                                               Minimum="0" Maximum="128"
                                               FormatString="0" />
                                <TextBlock Classes="HintText"
                                           Text="0 で完全一致のみ余白扱い。大きいほど許容（推奨 8）。" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
