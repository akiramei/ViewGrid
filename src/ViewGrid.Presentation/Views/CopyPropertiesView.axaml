<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
             x:Class="ViewGrid.Presentation.Views.CopyPropertiesView"
             x:DataType="vm:CopyPropertiesViewModel">

    <UserControl.Resources>
        <conv:ScalingModeLabelConverter x:Key="ScalingModeLabel" />
    </UserControl.Resources>

    <Border Padding="12">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="特性編集"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,8" />

            <TextBlock DockPanel.Dock="Top"
                       Text="論理コピーを選択してください"
                       Opacity="0.55"
                       IsVisible="{Binding !HasCopy}" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        Classes="accent" />
                <Button Content="リセット"
                        Command="{Binding RevertCommand}" />
                <TextBlock Text="*"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SystemAccentColor}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsDirty}"
                           ToolTip.Tip="未保存の変更があります" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,8,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasCopy}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="名前" FontSize="11" Opacity="0.75" />
                        <TextBox Text="{Binding CopyName}" PlaceholderText="（既定）" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="回転" FontSize="11" Opacity="0.75" />
                        <ComboBox ItemsSource="{Binding RotationOptions}"
                                  SelectedItem="{Binding Rotation}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="反転" FontSize="11" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox Content="水平 (H)" IsChecked="{Binding FlipX}" />
                            <CheckBox Content="垂直 (V)" IsChecked="{Binding FlipY}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="スケーリング" FontSize="11" Opacity="0.75" />
                        <ComboBox ItemsSource="{Binding ScalingModeOptions}"
                                  SelectedItem="{Binding ScalingMode}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ScalingModeLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="トリミング基準" FontSize="11" Opacity="0.75" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AnchorXOptions}"
                                      SelectedItem="{Binding TrimAnchorX}"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnchorYOptions}"
                                      SelectedItem="{Binding TrimAnchorY}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="アライメント" FontSize="11" Opacity="0.75" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AnchorXOptions}"
                                      SelectedItem="{Binding AlignX}"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnchorYOptions}"
                                      SelectedItem="{Binding AlignY}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="占有セル (W×H)" FontSize="11" Opacity="0.75" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <NumericUpDown Grid.Column="0"
                                           Value="{Binding OccupyWidth}"
                                           Minimum="1" Maximum="20"
                                           FormatString="0" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding OccupyHeight}"
                                           Minimum="1" Maximum="20"
                                           FormatString="0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
