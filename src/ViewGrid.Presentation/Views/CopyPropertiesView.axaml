<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             xmlns:loc="using:ViewGrid.Presentation.Localization"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
             x:Class="ViewGrid.Presentation.Views.CopyPropertiesView"
             x:Name="CopyPropertiesRoot"
             x:DataType="vm:CopyPropertiesViewModel">

    <UserControl.Resources>
        <conv:ScalingModeLabelConverter x:Key="ScalingModeLabel" />
        <conv:AutoCropPresetLabelConverter x:Key="AutoCropPresetLabel" />
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmap" />
    </UserControl.Resources>

    <!--
        外側 (準備タブ TabControl / 配置タブ Inspector) が Padding を確保するため、内側は 0 にして
        CopyPropertiesView の編集領域に最大限の幅を確保する。
    -->
    <Border Padding="0">
        <Grid>
            <!--
                バリアント未選択時の案内（HasCopy=false）。コントロール一式は IsVisible=false で
                完全に隠し、案内文だけを領域中央に大きく表示する。旧版は IsEnabled で disabled 表示
                していたが「グレーアウトされた半端な UI」「スクロールできない」「右の一部が見切れる」
                といった違和感があり、ユーザー指摘で「コントロールごと隠す」設計に変更した。
            -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsVisible="{Binding !HasCopy}">
                <PathIcon Data="{StaticResource ImageGeometry}"
                          Width="36" Height="36"
                          Opacity="0.35"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr CopyProps_NoSelection}"
                           FontSize="14"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr CopyProps_NoSelection_Hint}"
                           FontSize="11"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- バリアント選択時の編集 UI 一式（HasCopy=true のみ表示） -->
            <DockPanel LastChildFill="True"
                       IsVisible="{Binding HasCopy}">
            <!-- マルチセレクト中の案内（編集は 1 件選択時のみ可能） -->
            <Border DockPanel.Dock="Top"
                    Classes="WarningBanner"
                    Margin="0,4,0,8"
                    IsVisible="{Binding MultiSelectMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding MultiSelectMessage}"
                           FontSize="12" />
            </Border>

            <!--
                スタンドアロン用「保存 / リセット」バー。配置タブの Inspector に inline embed する
                場合は ShowSaveBar=False で隠し、Inspector 側の統一保存ボタンに任せる。
            -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                        IsVisible="{Binding #CopyPropertiesRoot.ShowSaveBar}">
                <Button Command="{Binding SaveCommand}"
                        Classes="accent"
                        ToolTip.Tip="{loc:Tr CopyProps_Save_Tooltip}">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource SaveGeometry}" Width="14" Height="14" />
                        <TextBlock Text="{loc:Tr Common_Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RevertCommand}"
                        ToolTip.Tip="{loc:Tr GridProps_Reset_Tooltip}">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource RefreshGeometry}" Width="14" Height="14" />
                        <TextBlock Text="{loc:Tr Common_Reset}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="●"
                           FontSize="14"
                           Foreground="{DynamicResource SystemAccentColor}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsDirty}"
                           ToolTip.Tip="{loc:Tr Common_UnsavedTooltip}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,8,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!--
                項目数増加に伴うタブ分割。「特性」は変形・配置の既存項目（編集頻度高、既定タブ）、
                「トリミング」は AutoCrop 全体（サムネプレビューを必要なときに広く使える）。
                IsDirty 状態はタブ間で共有、保存/リセットは下部共通なので両タブを跨いで一括編集可能。
            -->
            <Grid RowDefinitions="Auto,*">
                <!--
                    タブ見出しは編集 UI 内で「セクション切替」程度の役割なので、本文 (FormGroup の
                    SectionHeader) と視覚的に階層を作るため FontSize=14 に抑える。旧 26pt は
                    「画面の主役」級で、限られた縦スペースを食いすぎていた。Spacing も 24 → 12 に。
                -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,0,0,4">
                    <Button Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPropertiesTabClicked">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr CopyProps_Tab_Properties}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Border Height="2"
                                    Background="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding #CopyPropertiesRoot.IsPropertiesTabSelected}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCropTabClicked">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr CopyProps_Tab_Crop}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Border Height="2"
                                    Background="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding #CopyPropertiesRoot.IsCropTabSelected}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRegionsTabClicked">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr CopyProps_Tab_Regions}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Border Height="2"
                                    Background="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding #CopyPropertiesRoot.IsRegionsTabSelected}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--
                    特性タブ本文。スクロールは外側（PlacementInspectorView の共有特性カード *
                    行が所有する ScrollViewer）が担うので、ここは ScrollViewer を持たず
                    自然な高さで縦に流す。子 View 内で MaxHeight を当てに行くと、Bounds 計測
                    のタイミングずれで実 viewport と乖離するためスクロールが「バーは出るが
                    動かない」状態になっていた。子の責務を「コンテンツを配置する」に絞り、
                    親側の有限高さに任せる方針に統一。
                -->
                <StackPanel Grid.Row="1"
                            Classes="FormGroup"
                            IsVisible="{Binding #CopyPropertiesRoot.IsPropertiesTabSelected}">
                            <!--
                                バリアント名の編集はリスト上のインラインリネーム（F2 / ダブルクリック → Enter）
                                + 新規作成フライアウトの名前 TextBox に統合済み。
                                特性タブ側の「名前」TextBox は冗長なため削除した。
                            -->

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Rotation}" />
                                <ComboBox ItemsSource="{Binding RotationOptions}"
                                          SelectedItem="{Binding Rotation}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Flip}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="{loc:Tr CopyProps_FlipH}" IsChecked="{Binding FlipX}" />
                                    <CheckBox Content="{loc:Tr CopyProps_FlipV}" IsChecked="{Binding FlipY}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Scaling}" />
                                <ComboBox ItemsSource="{Binding ScalingModeOptions}"
                                          SelectedItem="{Binding ScalingMode}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ScalingModeLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!--
                                Alignment: 単一アンカーで「画像 ≤ セル での配置位置」と
                                「画像 > セル での表示部分」を両方表現する（CSS background-position と同じ）。
                                Fill モードでは画像がセルにピッタリ伸縮されるため Alignment は効かない。
                            -->
                            <StackPanel Classes="FormSection" IsEnabled="{Binding IsAlignmentActive}">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Alignment}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AnchorXOptions}"
                                              SelectedItem="{Binding AlignX}"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AnchorYOptions}"
                                              SelectedItem="{Binding AlignY}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>

                            <!--
                                占有セル UI は配置固有特性として PlacementInspector の
                                「配置固有」セクションへ移管した。同じバリアントを別グリッドの
                                別セルに配置しても、占有セルはそれぞれ独立して設定できる。
                            -->
                </StackPanel>

                <!--
                    トリミング: OFF / 自動（単色余白を外周走査） / 手動（任意矩形）の 3 択。
                    ManualCrop が ON のときは AutoCrop は無視される（Resolver で排他判定）。
                    どちらの場合も適用順序は「元画像 → Crop → 回転・反転 → ScalingMode/Alignment」。
                    特性タブと同じく ScrollViewer を持たず自然な高さで流す（親が外側でスクロール所有）。
                -->
                <StackPanel Grid.Row="1"
                            Classes="FormGroup"
                            IsVisible="{Binding #CopyPropertiesRoot.IsCropTabSelected}">
                            <!-- ラジオ 3 択（GroupName で排他化、VM 側でも排他連動） -->
                            <StackPanel Classes="FormSection">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_TrimMode}" />
                                <StackPanel Spacing="4">
                                    <RadioButton GroupName="CropMode"
                                                 Content="{loc:Tr CopyProps_TrimMode_Off}"
                                                 IsChecked="{Binding IsCropOff}" />
                                    <RadioButton GroupName="CropMode"
                                                 Content="{loc:Tr CopyProps_TrimMode_Auto}"
                                                 IsChecked="{Binding AutoCropEnabled}" />
                                    <RadioButton GroupName="CropMode"
                                                 Content="{loc:Tr CopyProps_TrimMode_Manual}"
                                                 IsChecked="{Binding ManualCropEnabled}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 自動：プリセット + Custom HEX + 閾値 + リアルタイムプレビュー（bbox 赤枠 + マット） -->
                            <StackPanel Classes="FormSection" IsVisible="{Binding AutoCropEnabled}">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_AutoCrop_TargetColor}" />
                                <ComboBox ItemsSource="{Binding AutoCropPresetOptions}"
                                          SelectedItem="{Binding AutoCropPreset}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AutoCropPresetLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- HEX 入力 (Custom 限定) -->
                                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding IsAutoCropCustom}">
                                    <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_AutoCrop_Hex}" />
                                    <TextBox Text="{Binding AutoCropCustomColorHex}"
                                             PlaceholderText="#FFFFFF" />
                                    <TextBlock Classes="HintText"
                                               Text="{loc:Tr CopyProps_AutoCrop_PickerHint}" />
                                </StackPanel>

                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_AutoCrop_Threshold}" Margin="0,8,0,0" />
                                <NumericUpDown Value="{Binding AutoCropThreshold}"
                                               Minimum="0" Maximum="128"
                                               FormatString="0"
                                               LostFocus="OnNumericUpDownLostFocus" />
                                <TextBlock Classes="HintText"
                                           Text="{loc:Tr CopyProps_AutoCrop_Threshold_Hint}" />

                                <!-- 走査結果メッセージ（クロップ範囲なし等） -->
                                <TextBlock Classes="HintText"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           Text="{Binding AutoCropPreviewMessage}"
                                           IsVisible="{Binding AutoCropPreviewMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Margin="0,8,0,0" />

                                <!--
                                    リアルタイムプレビュー: AutoCrop 有効中は常に表示。
                                    Image の上に Canvas overlay を Grid で重ね、bbox 赤枠 + 4 領域マット を描画。
                                    Custom プリセット時は Cursor=Cross + PointerPressed で色採取できるが、
                                    プリセット時はクリックしても何も起きない（CodeBehind で IsAutoCropCustom チェック）。
                                -->
                                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                        BorderThickness="1"
                                        Background="{DynamicResource SystemAltMediumLowColor}"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding HasThumbnail}">
                                    <!--
                                        Canvas を Image と同じ位置/サイズに強制同期する。
                                        HorizontalAlignment / VerticalAlignment を Center にし、
                                        CodeBehind で Canvas.Width / Height を Image.Bounds に追従させる。
                                        これで Canvas (0,0) = Image control 左上を保証し、
                                        overlay 矩形が Image 表示部分と完全一致する。
                                    -->
                                    <Grid>
                                        <Image x:Name="AutoCropPreviewImage"
                                               Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                               MaxHeight="240"
                                               Stretch="Uniform"
                                               Cursor="Cross"
                                               PointerPressed="OnColorPickerPointerPressed" />
                                        <Canvas x:Name="AutoCropPreviewOverlay"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 手動：サムネ上に矩形オーバーレイ + 数値入力 4 つ + 詳細編集ボタン -->
                            <StackPanel Classes="FormSection" IsVisible="{Binding ManualCropEnabled}">
                                <TextBlock Classes="HintText"
                                           Text="{loc:Tr CopyProps_ManualCrop_Hint}" />

                                <Button x:Name="OpenDetailEditorButton"
                                        Content="{loc:Tr CopyProps_ManualCrop_DetailButton}"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding HasThumbnail}"
                                        Click="OnOpenDetailEditorClicked" />

                                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                        BorderThickness="1"
                                        Background="{DynamicResource SystemAltMediumLowColor}"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding HasThumbnail}">
                                    <!-- Image とオーバーレイ Canvas を Grid で重ねる。
                                         Canvas は HorizontalAlignment/VerticalAlignment=Center で
                                         CodeBehind から Image.Bounds に Width/Height 同期する
                                         （これで Canvas (0,0) = Image control 左上を保証）。
                                         Canvas 上で PointerPressed/Moved/Released を扱い、
                                         CodeBehind がサムネ座標 → 元画像比率に等比換算する。 -->
                                    <Grid x:Name="ManualCropContainer">
                                        <Image x:Name="ManualCropImage"
                                               Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                               MaxHeight="240"
                                               Stretch="Uniform" />
                                        <Canvas x:Name="ManualCropOverlay"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Cursor="Cross"
                                                PointerPressed="OnManualCropOverlayPointerPressed"
                                                PointerMoved="OnManualCropOverlayPointerMoved"
                                                PointerReleased="OnManualCropOverlayPointerReleased" />
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_ManualCrop_X}" />
                                        <NumericUpDown Value="{Binding ManualCropPixelX}"
                                                       Minimum="0"
                                                       FormatString="0"
                                                       IsEnabled="{Binding IsManualCropDefined}"
                                                       LostFocus="OnNumericUpDownLostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_ManualCrop_Y}" />
                                        <NumericUpDown Value="{Binding ManualCropPixelY}"
                                                       Minimum="0"
                                                       FormatString="0"
                                                       IsEnabled="{Binding IsManualCropDefined}"
                                                       LostFocus="OnNumericUpDownLostFocus" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_ManualCrop_W}" />
                                        <NumericUpDown Value="{Binding ManualCropPixelWidth}"
                                                       Minimum="0"
                                                       FormatString="0"
                                                       IsEnabled="{Binding IsManualCropDefined}"
                                                       LostFocus="OnNumericUpDownLostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_ManualCrop_H}" />
                                        <NumericUpDown Value="{Binding ManualCropPixelHeight}"
                                                       Minimum="0"
                                                       FormatString="0"
                                                       IsEnabled="{Binding IsManualCropDefined}"
                                                       LostFocus="OnNumericUpDownLostFocus" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                </StackPanel>

                <!--
                    保護領域タブ本文。 通常 / PhotoBoard 出力両対応 (セル内ステッカー方式)。
                    一覧 ListBox + 追加 / 編集 / 削除 ボタン + 選択行の詳細 (Offset / 塗りモード / 色採取)。
                -->
                <StackPanel Grid.Row="1"
                            Classes="FormGroup"
                            IsVisible="{Binding #CopyPropertiesRoot.IsRegionsTabSelected}">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_Header}" />
                        <TextBlock Text="{loc:Tr CopyProps_Regions_Description}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,8" />

                        <ListBox ItemsSource="{Binding RegionItems}"
                                 SelectedItem="{Binding SelectedRegion}"
                                 MaxHeight="200"
                                 Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ProtectedRegionItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource ImageGeometry}"
                                                  Width="12" Height="12"
                                                  Opacity="0.6" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddRegionCommand}"
                                    ToolTip.Tip="{loc:Tr CopyProps_Regions_Add_Tooltip}">
                                <StackPanel Classes="IconButtonContent">
                                    <PathIcon Data="{StaticResource AddGeometry}" Width="12" Height="12" />
                                    <TextBlock Text="{loc:Tr Common_Add}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnEditRegionClicked"
                                    Content="{loc:Tr Common_Edit}"
                                    IsEnabled="{Binding SelectedRegion, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="{loc:Tr CopyProps_Regions_Edit_Tooltip}" />
                            <Button Command="{Binding MoveSelectedRegionUpCommand}"
                                    Content="↑"
                                    ToolTip.Tip="{loc:Tr CopyProps_Regions_MoveUp_Tooltip}" />
                            <Button Command="{Binding MoveSelectedRegionDownCommand}"
                                    Content="↓"
                                    ToolTip.Tip="{loc:Tr CopyProps_Regions_MoveDown_Tooltip}" />
                            <Button Command="{Binding RemoveRegionCommand}"
                                    Classes="iconDanger"
                                    ToolTip.Tip="{loc:Tr CopyProps_Regions_Remove_Tooltip}">
                                <StackPanel Classes="IconButtonContent">
                                    <PathIcon Data="{StaticResource DeleteGeometry}" Width="12" Height="12" />
                                    <TextBlock Text="{loc:Tr Common_Delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{loc:Tr CopyProps_Regions_Empty}"
                                   FontSize="11"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   IsVisible="{Binding HasNoRegions}" />

                        <!--
                            選択中の region の詳細。 SelectedRegion=null では非表示。
                            Offset (px、 負値可) + 塗りモード (4 プリセット) + Custom 時の HEX 入力 + 画像クリック採取。
                            VM レベルのプロパティ (RegionFillModeOptions, ThumbnailPath, HasThumbnail) は
                            #CopyPropertiesRoot.DataContext 経由で参照する (内側 DataContext は SelectedRegion)。
                        -->
                        <StackPanel x:Name="RegionDetailPanel"
                                    Spacing="6"
                                    Margin="0,12,0,0"
                                    DataContext="{Binding SelectedRegion}"
                                    IsVisible="{Binding #CopyPropertiesRoot.DataContext.SelectedRegion, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_SelectedHeader}" />

                            <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto">
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_OffsetX}" />
                                    <NumericUpDown Value="{Binding OffsetXPx}"
                                                   FormatString="0"
                                                   Increment="1"
                                                   LostFocus="OnNumericUpDownLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_OffsetY}" />
                                    <NumericUpDown Value="{Binding OffsetYPx}"
                                                   FormatString="0"
                                                   Increment="1"
                                                   LostFocus="OnNumericUpDownLostFocus" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_RotationLabel}" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{Binding #CopyPropertiesRoot.DataContext.RotationOptions}"
                                      SelectedItem="{Binding Rotation}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_FlipLabel}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox Content="{loc:Tr CopyProps_FlipH}" IsChecked="{Binding FlipX}" />
                                <CheckBox Content="{loc:Tr CopyProps_FlipV}" IsChecked="{Binding FlipY}" />
                            </StackPanel>

                            <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_FillMode}" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{Binding #CopyPropertiesRoot.DataContext.RegionFillModeOptions}"
                                      SelectedItem="{Binding FillMode}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:ProtectedRegionFillModeLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Custom 時のみ HEX 入力 -->
                            <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsFillCustom}">
                                <TextBlock Classes="FieldLabel" Text="{loc:Tr CopyProps_Regions_HexLabel}" />
                                <TextBox Text="{Binding FillColorHex}"
                                         PlaceholderText="#FFFFFFFF" />
                                <TextBlock Classes="HintText"
                                           Text="{loc:Tr CopyProps_Regions_HexHint}" />
                            </StackPanel>

                            <!-- 元画像サムネ + クリック採取。 Custom でなくても表示 (採取で自動的に Custom になる)。 -->
                            <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SystemAltMediumLowColor}"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding #CopyPropertiesRoot.DataContext.HasThumbnail}">
                                <Image x:Name="RegionColorPickerImage"
                                       Source="{Binding #CopyPropertiesRoot.DataContext.ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                       MaxHeight="180"
                                       Stretch="Uniform"
                                       Cursor="Cross"
                                       PointerPressed="OnRegionColorPickerPointerPressed" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
