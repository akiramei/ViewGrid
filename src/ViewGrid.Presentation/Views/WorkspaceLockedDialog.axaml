<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:ViewGrid.Presentation.Localization"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="220"
        x:Class="ViewGrid.Presentation.Views.WorkspaceLockedDialog"
        Title="{loc:Tr WorkspaceLocked_Title}"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="460"
        SizeToContent="Height"
        MinHeight="200"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="10">
        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Text="{loc:Tr WorkspaceLocked_Header}" />

        <TextBlock Grid.Row="1"
                   x:Name="WorkspaceNameText"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="2"
                   x:Name="OwnerInfoText"
                   Opacity="0.8"
                   FontSize="12" />

        <TextBlock Grid.Row="3"
                   Classes="HintText"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="{loc:Tr WorkspaceLocked_Hint}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button Content="{loc:Tr Common_Close}"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Classes="accent"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
