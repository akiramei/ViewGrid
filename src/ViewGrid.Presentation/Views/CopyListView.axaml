<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="300"
             x:Class="ViewGrid.Presentation.Views.CopyListView"
             x:DataType="vm:CopyListViewModel">

    <Border Padding="12"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="論理コピー"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,8" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="+ 新規"
                        Command="{Binding CreateCopyCommand}"
                        IsEnabled="{Binding HasAsset}" />
                <Button Content="削除"
                        Command="{Binding DeleteSelectedCopyCommand}" />
                <TextBlock Text="{Binding SelectedCount, StringFormat='({0} 件選択中)'}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="11"
                           IsVisible="{Binding IsMultiSelected}" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="80"
                             VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,8,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock DockPanel.Dock="Top"
                       Text="アセットを選択してください"
                       Opacity="0.55"
                       IsVisible="{Binding !HasAsset}" />

            <ListBox x:Name="CopyList"
                     ItemsSource="{Binding Copies}"
                     SelectedItem="{Binding SelectedCopy}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnCopyListSelectionChanged"
                     IsVisible="{Binding HasAsset}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CopyItemViewModel">
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SummaryLine}" Opacity="0.65" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
