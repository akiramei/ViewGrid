<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             xmlns:loc="using:ViewGrid.Presentation.Localization"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="380"
             x:Name="GridPropertiesRoot"
             x:Class="ViewGrid.Presentation.Views.GridPropertiesView"
             x:DataType="vm:GridCanvasItemViewModel">

    <UserControl.Resources>
        <conv:ImmutableArrayJoinConverter x:Key="ArrayJoin" />
        <conv:LockedCountConverter x:Key="LockedCount" />
    </UserControl.Resources>

    <!--
        配置タブの右ペイン下段で、 グリッド選択中 (配置未選択) に表示される編集パネル。
        グリッド名 + キャンバスサイズを 「ドラフト編集 → IsDirty → 保存ボタン」 パターンで編集。
        CopyProperties / PlacementInspector と同じ動線。 重み / ロックはキャンバスの境界ハンドル /
        ヘッダクリックから操作する設計を維持 (こちらは即時保存)。
        SaveCommand / RevertCommand は親 GridCanvasListViewModel の CommitEditing / RevertEditing。
    -->
    <Border Padding="10,8"
            CornerRadius="4"
            Background="{DynamicResource SystemChromeLowColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Classes="FormGroup">

                <!--
                    保存バー (Inspector の SaveAll/RevertAll と同じ視覚パターン)。
                    SaveCommand / RevertCommand は AvaloniaProperty 経由で親 axaml から渡される。
                -->
                <Border Classes="SubtleCard" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OnSaveClicked"
                                Classes="accent"
                                IsEnabled="{Binding IsDirty}"
                                ToolTip.Tip="{loc:Tr GridProps_Save_Tooltip}">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource SaveGeometry}" Width="14" Height="14" />
                                <TextBlock Text="{loc:Tr Common_Save}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRevertClicked"
                                IsEnabled="{Binding IsDirty}"
                                ToolTip.Tip="{loc:Tr GridProps_Reset_Tooltip}">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource RefreshGeometry}" Width="14" Height="14" />
                                <TextBlock Text="{loc:Tr Common_Reset}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="●"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsDirty}"
                                   ToolTip.Tip="{loc:Tr Common_UnsavedTooltip}" />
                    </StackPanel>
                </Border>

                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_GridName}" />
                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                             FontWeight="SemiBold"
                             FontSize="13" />
                </StackPanel>

                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_CellCount}" />
                    <TextBlock Text="{Binding GridSizeLabel}" FontSize="12" />
                </StackPanel>

                <!--
                    キャンバスサイズ (出力 PNG の解像度)。 配置 (CellPosition / OccupySize) や重みは
                    変更されないので、 セルが等倍で拡縮されるだけ。 永続化は保存ボタン押下時のみ。
                -->
                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_CanvasSize}" />
                    <Grid ColumnDefinitions="*,8,*"
                          RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{loc:Tr GridProps_Width}" FontSize="11" Opacity="0.75" />
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{loc:Tr GridProps_Height}" FontSize="11" Opacity="0.75" />
                        <NumericUpDown Grid.Column="0" Grid.Row="1"
                                       Value="{Binding EditingCanvasWidth, Mode=TwoWay}"
                                       Minimum="1" Maximum="16384"
                                       Increment="100"
                                       FormatString="0"
                                       FontSize="12" />
                        <NumericUpDown Grid.Column="2" Grid.Row="1"
                                       Value="{Binding EditingCanvasHeight, Mode=TwoWay}"
                                       Minimum="1" Maximum="16384"
                                       Increment="100"
                                       FormatString="0"
                                       FontSize="12" />
                    </Grid>
                </StackPanel>

                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_ColRatios}" />
                    <TextBlock Text="{Binding ColWeights, Converter={StaticResource ArrayJoin}}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_RowRatios}" />
                    <TextBlock Text="{Binding RowWeights, Converter={StaticResource ArrayJoin}}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Classes="FormSection">
                    <TextBlock Classes="FieldLabel" Text="{loc:Tr GridProps_Locks}" />
                    <TextBlock FontSize="12">
                        <Run Text="{loc:Tr GridProps_ColLocks_Prefix}" />
                        <Run Text="{Binding ColLocked, Converter={StaticResource LockedCount}, Mode=OneWay}" />
                        <Run Text="{loc:Tr GridProps_RowLocks_Prefix}" />
                        <Run Text="{Binding RowLocked, Converter={StaticResource LockedCount}, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Classes="HintText"
                           Text="{loc:Tr GridProps_Hint}" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
