<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
        x:Class="ViewGrid.Presentation.Views.ManualCropEditorWindow"
        Title="任意矩形トリミング"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="1000" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 上部: ズームコントロール + ヒント -->
        <Grid Grid.Row="0" Margin="12,12,12,6" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="ズーム:" VerticalAlignment="Center" />
                <Button x:Name="ZoomOutButton" Content="−" MinWidth="32" Click="OnZoomOutClicked" ToolTip.Tip="縮小" />
                <Button x:Name="ZoomFitButton" Content="フィット" Click="OnZoomFitClicked" ToolTip.Tip="ウィンドウに収める" />
                <Button x:Name="Zoom100Button" Content="100%" Click="OnZoom100Clicked" ToolTip.Tip="物理ピクセル等倍" />
                <Button x:Name="ZoomInButton" Content="＋" MinWidth="32" Click="OnZoomInClicked" ToolTip.Tip="拡大" />
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="56" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="画像上をドラッグで矩形作成 / 中ボタン or Space+ドラッグでパン"
                       Opacity="0.7"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextWrapping="Wrap">
                <ToolTip.Tip>
                    <TextBlock>
                        <Run Text="画像上をドラッグで矩形作成" /><LineBreak />
                        <Run Text="8 ハンドルで端 / 隅をリサイズ" /><LineBreak />
                        <Run Text="矩形内部ドラッグで移動" /><LineBreak />
                        <Run Text="ドラッグ中に画像端へ近づくと自動スクロール" /><LineBreak />
                        <Run Text="中ボタンドラッグ または Space + 左ドラッグでパン" /><LineBreak />
                        <Run Text="矢印キーで 1px 移動、 Shift + 矢印で 10px 移動" />
                    </TextBlock>
                </ToolTip.Tip>
            </TextBlock>
        </Grid>

        <!-- メイン: ScrollViewer + 画像 + Canvas オーバーレイ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                Margin="12,6,12,6">
            <ScrollViewer x:Name="EditorScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <!-- HorizontalAlignment/VerticalAlignment="Left/Top" で zoom 拡大時にスクロール可能化。
                     Image/Canvas は同サイズで Grid に重ねる（Children は同じ位置に重なる）。 -->
                <Grid x:Name="EditorContainer"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <!-- 高倍率時にドット絵がぼやけないよう、 線形補間ではなく最近傍 (Nearest Neighbor) を使う。 -->
                    <Image x:Name="EditorImage" Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Canvas x:Name="EditorOverlay"
                            Background="Transparent"
                            Cursor="Cross"
                            PointerPressed="OnOverlayPointerPressed"
                            PointerMoved="OnOverlayPointerMoved"
                            PointerReleased="OnOverlayPointerReleased"
                            PointerCaptureLost="OnOverlayPointerCaptureLost" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 下部: 数値入力 + OK/キャンセル -->
        <Grid Grid.Row="2" Margin="12,6,12,12" ColumnDefinitions="Auto,*,Auto,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- NumericUpDown はスピナーボタン（▲▼）に幅を取られるため、本体テキスト分も含めて
                     MinWidth=140 にする（4 桁ピクセル値 + スピナーが収まるサイズ）。 -->
                <TextBlock Text="X:" VerticalAlignment="Center" />
                <NumericUpDown x:Name="XInput" MinWidth="140" Minimum="0" FormatString="0" ValueChanged="OnNumericValueChanged" />
                <TextBlock Text="Y:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <NumericUpDown x:Name="YInput" MinWidth="140" Minimum="0" FormatString="0" ValueChanged="OnNumericValueChanged" />
                <TextBlock Text="幅:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <NumericUpDown x:Name="WInput" MinWidth="140" Minimum="0" FormatString="0" ValueChanged="OnNumericValueChanged" />
                <TextBlock Text="高さ:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <NumericUpDown x:Name="HInput" MinWidth="140" Minimum="0" FormatString="0" ValueChanged="OnNumericValueChanged" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="OK"
                    Classes="accent"
                    Margin="0,0,8,0"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    Click="OnOkClicked" />
            <Button Grid.Column="3"
                    Content="キャンセル"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    Click="OnCancelClicked" />
        </Grid>
    </Grid>
</Window>
