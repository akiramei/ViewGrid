<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ViewGrid.Application.ViewModels"
        xmlns:loc="using:ViewGrid.Presentation.Localization"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
        x:Class="ViewGrid.Presentation.Views.WorkspaceSwitchDialog"
        x:DataType="vm:WorkspaceSwitchDialogViewModel"
        Title="{loc:Tr Workspace_Title}"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="520" Height="520"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="20" RowSpacing="10">
        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Text="{loc:Tr Workspace_Title}" />

        <TextBlock Grid.Row="1"
                   Classes="HintText"
                   TextWrapping="Wrap"
                   Text="{loc:Tr Workspace_Hint}" />

        <!-- ワークスペース一覧 -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox ItemsSource="{Binding Workspaces}"
                     SelectedItem="{Binding SelectedWorkspace}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:WorkspaceSwitchDialogViewModel+WorkspaceItem">
                        <!-- 列幅 16px は ● の有無に依らず固定し、 IsActive で切替えても DisplayName の左端が揃うように -->
                        <Grid ColumnDefinitions="16,*,Auto" Margin="2,4">
                            <TextBlock Grid.Column="0"
                                       Text="●"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding IsActive}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name, StringFormat=' ({0})'}"
                                           Opacity="0.6"
                                           FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{loc:Tr Workspace_CurrentlyInUse}"
                                       Opacity="0.7"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,4,0"
                                       IsVisible="{Binding IsActive}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- リネーム + 削除 (選択中ワークスペース用) - 新規作成中は隠す -->
        <Border Grid.Row="3"
                Classes="Card"
                IsVisible="{Binding ShowSelectedEditor}">
            <StackPanel Spacing="6">
                <TextBlock Classes="SectionHeader">
                    <Run Text="{loc:Tr Workspace_SelectedPrefix}" /><Run Text="{Binding SelectedWorkspace.DisplayName, FallbackValue=''}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{loc:Tr Workspace_RenameDisplayName}" Classes="FieldLabel" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             Text="{Binding EditingDisplayName}"
                             PlaceholderText="{loc:Tr Workspace_DisplayName_Placeholder}" />
                    <Button Grid.Column="1"
                            Content="{loc:Tr Common_Save}"
                            MinWidth="64"
                            HorizontalContentAlignment="Center"
                            Click="OnRenameClicked" />
                </Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6">
                    <Button Click="OnDuplicateClicked"
                            ToolTip.Tip="{loc:Tr Workspace_Duplicate_Tooltip}">
                        <StackPanel Classes="IconButtonContent">
                            <PathIcon Data="{StaticResource AddGeometry}" Width="14" Height="14" />
                            <TextBlock Text="{loc:Tr Workspace_Duplicate}" />
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding CanExportSelected}"
                            Click="OnExportClicked"
                            ToolTip.Tip="{loc:Tr Workspace_Export_Tooltip}">
                        <StackPanel Classes="IconButtonContent">
                            <PathIcon Data="{StaticResource ExportGeometry}" Width="14" Height="14" />
                            <TextBlock Text="{loc:Tr Workspace_Export}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconDanger"
                            IsEnabled="{Binding CanDeleteSelected}"
                            Click="OnDeleteClicked"
                            ToolTip.Tip="{loc:Tr Workspace_Delete_Tooltip}">
                        <StackPanel Classes="IconButtonContent">
                            <PathIcon Data="{StaticResource DeleteGeometry}" Width="14" Height="14" />
                            <TextBlock Text="{loc:Tr Common_Delete}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 新規作成フォーム (フライアウト風) -->
        <Border Grid.Row="4"
                Classes="Card"
                IsVisible="{Binding IsCreating}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding CreateCardTitle}" Classes="SectionHeader" />
                <TextBlock Classes="HintText"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !IsDuplicateMode}"
                           Text="{loc:Tr Workspace_Create_Hint}" />
                <TextBlock Classes="HintText"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsDuplicateMode}"
                           Text="{loc:Tr Workspace_Duplicate_Hint}" />
                <TextBlock Text="{loc:Tr Workspace_InternalName_Label}"
                           Classes="FieldLabel"
                           Margin="0,4,0,0" />
                <TextBox Text="{Binding DraftName}"
                         PlaceholderText="{loc:Tr Workspace_InternalName_Placeholder}" />
                <TextBlock Text="{loc:Tr Workspace_DisplayName_Label}" Classes="FieldLabel" />
                <TextBox Text="{Binding DraftDisplayName}"
                         PlaceholderText="{loc:Tr Workspace_DisplayName_CreatePlaceholder}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6"
                            Margin="0,4,0,0">
                    <Button Content="{loc:Tr Common_Cancel}"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Click="OnCancelCreateClicked" />
                    <Button Content="{Binding CreateConfirmLabel}"
                            Classes="accent"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding CanCreate}"
                            Click="OnConfirmCreateClicked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ステータス + フッタ -->
        <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock Classes="HintText"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SystemErrorTextColor}" />
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Content="{loc:Tr Workspace_New}"
                        IsEnabled="{Binding !IsCreating}"
                        Click="OnBeginCreateClicked" />
                <Button Grid.Column="1"
                        IsEnabled="{Binding CanImport}"
                        Click="OnImportClicked"
                        ToolTip.Tip="{loc:Tr Workspace_Import_Tooltip}">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource ImportGeometry}" Width="14" Height="14" />
                        <TextBlock Text="{loc:Tr Workspace_Import}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Content="{loc:Tr Common_Close}"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsCancel="True"
                        Click="OnCancelClicked" />
                <Button Grid.Column="4"
                        x:Name="ApplyButton"
                        Content="{loc:Tr Workspace_RestartAndSwitch}"
                        Classes="accent"
                        MinWidth="120"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{Binding CanApply}"
                        Click="OnApplyClicked" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
