<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="ViewGrid.Presentation.Views.GridCanvasView"
             x:DataType="vm:GridWorkspaceViewModel"
             Focusable="True"
             IsTabStop="False">

    <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            Background="{DynamicResource SystemChromeMediumLowColor}">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <!--
                上端/左端 24px のヘッダバー + キャンバス本体。
                外側 Grid の Width/Height とキャンバス Container の Width/Height は
                ユーザーの CanvasSize アスペクトに合わせて Rebuild() で動的に設定する
                （PNG 出力と表示の比率を一致させるため）。
                XAML の初期値 624×624 は「グリッド未ロード時のフォールバック」。
            -->
            <Grid x:Name="OuterCanvasGrid"
                  Width="624" Height="624"
                  RowDefinitions="24,*" ColumnDefinitions="24,*">
                <!-- (0,1): 列ヘッダバー（列ロック切替） -->
                <Grid x:Name="ColHeaderBar"
                      Grid.Row="0" Grid.Column="1"
                      Background="{DynamicResource SystemChromeMediumColor}" />
                <!-- (1,0): 行ヘッダバー（行ロック切替） -->
                <Grid x:Name="RowHeaderBar"
                      Grid.Row="1" Grid.Column="0"
                      Background="{DynamicResource SystemChromeMediumColor}" />
                <!-- (1,1): キャンバス本体。Width/Height は Rebuild() で設定する（フォールバック 600×600） -->
                <Grid x:Name="CanvasContainer"
                      Grid.Row="1" Grid.Column="1"
                      Width="600" Height="600">
                    <Grid x:Name="CanvasGrid" Background="White">
                        <!--
                            選択枠 Adornment (C 案)。placement Border は常に Margin=0 / BorderThickness=0
                            で Image を Renderer と完全同一 geometry で配置するため、選択強調は別レイヤーで
                            重ねる。layout に参加せず Image 位置に影響しないよう IsHitTestVisible=False、
                            placement Border より手前に出るよう ZIndex=100 を指定。Grid.Row/Column/RowSpan/
                            ColumnSpan は CodeBehind が SelectedPlacement 変更時に更新する。
                        -->
                        <Border x:Name="SelectionOverlay"
                                BorderBrush="DodgerBlue"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                IsVisible="False"
                                ZIndex="100">
                            <Border.Background>
                                <SolidColorBrush Color="#3399FF" Opacity="0.25" />
                            </Border.Background>
                        </Border>
                        <!--
                            D&D ハイライト Adornment。Swap (黄) / Invalid (赤) を表現する。
                            旧実装は placement Border の BorderThickness=4 を直接書き換えていたが
                            layout に参加して画像が 4px 内側にズレる問題があったため Adornment 化。
                            BorderBrush / Background は CodeBehind の ApplyPlacementHighlight で動的設定。
                            ZIndex=101 で SelectionOverlay より手前 (D&D ハイライトの方が一時的・優先度高)。
                        -->
                        <Border x:Name="DragHighlightOverlay"
                                BorderThickness="4"
                                IsHitTestVisible="False"
                                IsVisible="False"
                                ZIndex="101" />

                        <!--
                            保護領域選択フレーム。SelectedRegion が非 null かつ SelectedPlacement の
                            セル内に asset が配置されているとき、 asset bbox にオレンジ枠 + asset preview を重ねる。
                            HorizontalAlignment / VerticalAlignment は Left / Top 固定で、 CodeBehind が
                            Margin / Width / Height を直接設定する (Grid のセルに依らず絶対座標で位置決め)。
                            IsHitTestVisible=True にして Shift+ドラッグの掴み代として使う。
                            Background は透明: Border 内の Image (RegionAssetPreview) で source の region 切り出しを
                            表示し、 オレンジ 2px 枠で 「選択中」 を示す。
                        -->
                        <Border x:Name="RegionSelectionFrame"
                                BorderBrush="#FF8C42"
                                BorderThickness="2"
                                Background="Transparent"
                                IsHitTestVisible="True"
                                IsVisible="False"
                                ZIndex="102"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Cursor="SizeAll">
                            <Image x:Name="RegionAssetPreview"
                                   Stretch="Fill"
                                   IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                    <!-- 境界ドラッグ用ハンドル（A2）。Canvas 上に絶対配置。
                         Background は付けない（Background があると Canvas 全体が hit-test 対象になり、
                         配置 Border の D&D を奪ってしまう）。子の Rectangle ハンドルだけが hit-test。 -->
                    <Canvas x:Name="BoundaryOverlay" IsHitTestVisible="True" />
                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
