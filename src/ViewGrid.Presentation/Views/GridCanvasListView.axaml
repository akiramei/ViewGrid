<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="60"
             x:Class="ViewGrid.Presentation.Views.GridCanvasListView"
             x:DataType="vm:GridCanvasListViewModel">

    <!--
        コンパクト版グリッド切替バー（配置タブ最上部に水平配置）。
        旧来の縦長 ListBox は「複数グリッドを行き来する作業ではない」のに大きなスペースを
        占有していたため、ComboBox + 操作ボタンの 1 行構造に置き換えた。
        新規作成時は下方向に作成フライアウトを展開する（IsCreating で IsVisible 制御）。
    -->
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <DockPanel LastChildFill="True">

            <!-- ステータスメッセージ（最下部固定） -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,4,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!--
                新規グリッド作成フライアウト。「+ 新規」を押すと展開し、作成 / キャンセルで閉じる。
                旧版と同じ入力項目（名前 / 行 / 列 / サイズ / 比率）を維持。
            -->
            <Border DockPanel.Dock="Bottom"
                    Padding="12"
                    Margin="0,8,0,0"
                    CornerRadius="4"
                    Background="{DynamicResource SystemChromeLowColor}"
                    IsVisible="{Binding IsCreating}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionHeader" Text="新規グリッド" />
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="名前" />
                            <TextBox Text="{Binding DraftName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="行" />
                            <NumericUpDown Value="{Binding DraftRows}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="列" />
                            <NumericUpDown Value="{Binding DraftCols}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="幅 (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasWidth}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="高さ (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasHeight}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="列比率（カンマ区切り、空＝均等）" />
                            <TextBox Text="{Binding DraftColWeights}" PlaceholderText="例: 2,1,1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="行比率（カンマ区切り、空＝均等）" />
                            <TextBox Text="{Binding DraftRowWeights}" PlaceholderText="例: 2,1,1" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="作成"
                                Command="{Binding ConfirmCreateCommand}"
                                Classes="accent" />
                        <Button Content="キャンセル"
                                Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                メイン行: グリッド ComboBox + アクションボタン群。
                ComboBox の ItemTemplate でアクティブ表示（●）とサイズラベルを横並びで表示する。
            -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="グリッド:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Grids}"
                          SelectedItem="{Binding SelectedGrid}"
                          MinWidth="320"
                          PlaceholderText="（グリッド未選択）"
                          ToolTip.Tip="作業対象のグリッドを切替">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:GridCanvasItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="●"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           IsVisible="{Binding IsActive}" />
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GridSizeLabel}"
                                           Opacity="0.7"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="—"
                                           Opacity="0.4"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CanvasSizeLabel}"
                                           Opacity="0.7"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="+ 新規"
                        Command="{Binding BeginCreateCommand}"
                        IsEnabled="{Binding !IsCreating}"
                        ToolTip.Tip="新しいグリッドを作成" />
                <Button Content="削除"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding SelectedGrid, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="選択中のグリッドを削除" />
                <Button Content="アクティブ化"
                        Command="{Binding ActivateSelectedCommand}"
                        IsEnabled="{Binding SelectedGrid, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="選択中のグリッドをアクティブにする（既定は最後に作成したグリッド）" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="80"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
