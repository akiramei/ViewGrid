<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="60"
             x:Class="ViewGrid.Presentation.Views.GridCanvasListView"
             x:DataType="vm:GridCanvasListViewModel">

    <!--
        コンパクト版グリッド切替バー（配置タブ最上部に水平配置）。
        旧来の縦長 ListBox は「複数グリッドを行き来する作業ではない」のに大きなスペースを
        占有していたため、ComboBox + 操作ボタンの 1 行構造に置き換えた。
        新規作成時は下方向に作成フライアウトを展開する（IsCreating で IsVisible 制御）。
    -->
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <DockPanel LastChildFill="True">

            <!-- ステータスメッセージ（最下部固定） -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,4,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!--
                新規グリッド作成フライアウト。「+ 新規」を押すと展開し、作成 / キャンセルで閉じる。
                行 / 列 / 幅 / 高さを 1 行に詰めて間延びを抑える。比率はオプションなので最下段に。
            -->
            <Border DockPanel.Dock="Bottom"
                    Padding="10"
                    Margin="0,8,0,0"
                    CornerRadius="4"
                    Background="{DynamicResource SystemChromeLowColor}"
                    IsVisible="{Binding IsCreating}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="SectionHeader" Text="新規グリッド" />

                    <!--
                        名前 + 行 + 列 + 幅 + 高さ を 1 行に詰める。各フィールドは固定幅で
                        値が確実に表示されるサイズを保証:
                        ・名前: 240px（30 文字程度の見出しに十分）
                        ・行 / 列: 110px（最大値 20 = 2 桁 + ▲▼ スピナーボタン分の幅）
                          NumericUpDown はスピナー部分が 40px 前後使うため、2 桁を確実に
                          見せるには 110px 必要（80px だと数値部分が 0 近くまで潰れる）
                        ・幅 / 高さ: 150px（最大値 8192 = 4 桁 + スピナーボタン）
                        ・末尾の * 列は余白（ウィンドウ幅に依存しない安定レイアウト）
                    -->
                    <Grid ColumnDefinitions="240,110,110,150,150,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="名前" />
                            <TextBox Text="{Binding DraftName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="行" />
                            <NumericUpDown Value="{Binding DraftRows}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="列" />
                            <NumericUpDown Value="{Binding DraftCols}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="幅 (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasWidth}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="高さ (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasHeight}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                    </Grid>

                    <!--
                        比率（オプション）。空欄＝均等。任意項目なので主張を抑えるため、
                        固定幅 200px 程度に抑えて左寄せ、右側は空白にする。
                    -->
                    <Grid ColumnDefinitions="200,200,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="列比率（任意・カンマ区切り）" />
                            <TextBox Text="{Binding DraftColWeights}" PlaceholderText="例: 2,1,1（空=均等）" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="行比率（任意・カンマ区切り）" />
                            <TextBox Text="{Binding DraftRowWeights}" PlaceholderText="例: 2,1,1（空=均等）" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Button Content="作成"
                                Command="{Binding ConfirmCreateCommand}"
                                Classes="accent" />
                        <Button Content="キャンセル"
                                Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                メイン行: グリッド ComboBox + アクションボタン群。
                起動時は AppSettings.LastOpenedGridId で 「直前に開いていたグリッド」 を自動復元する。
                ComboBox では選択中のものが SelectedItem ハイライトでそのまま分かる。
            -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="グリッド:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Grids}"
                          SelectedItem="{Binding SelectedGrid}"
                          MinWidth="320"
                          PlaceholderText="（グリッド未選択）"
                          ToolTip.Tip="作業対象のグリッドを切替（次回起動時はここで最後に選んだグリッドが開きます）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:GridCanvasItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GridSizeLabel}"
                                           Opacity="0.7"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="—"
                                           Opacity="0.4"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CanvasSizeLabel}"
                                           Opacity="0.7"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="+ 新規"
                        Classes="accent"
                        Command="{Binding BeginCreateCommand}"
                        IsEnabled="{Binding !IsCreating}"
                        ToolTip.Tip="新しいグリッドを作成" />
                <Button Content="削除"
                        Classes="iconDanger"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding SelectedGrid, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="選択中のグリッドを削除" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="80"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
