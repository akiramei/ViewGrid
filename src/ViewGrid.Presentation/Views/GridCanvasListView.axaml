<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="500"
             x:Class="ViewGrid.Presentation.Views.GridCanvasListView"
             x:DataType="vm:GridCanvasListViewModel">

    <Border Padding="12" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Classes="SectionHeader"
                       Text="グリッド"
                       Margin="0,0,0,8" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="+ 新規"
                        Command="{Binding BeginCreateCommand}"
                        IsEnabled="{Binding !IsCreating}" />
                <Button Content="削除"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding SelectedGrid, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="アクティブ化"
                        Command="{Binding ActivateSelectedCommand}" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="60"
                             VerticalAlignment="Center" />
            </StackPanel>

            <Border DockPanel.Dock="Top"
                    Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="4"
                    Background="{DynamicResource SystemChromeLowColor}"
                    IsVisible="{Binding IsCreating}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionHeader" Text="新規グリッド" />
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="FieldLabel" Text="名前" />
                        <TextBox Text="{Binding DraftName}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="行" />
                            <NumericUpDown Value="{Binding DraftRows}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="列" />
                            <NumericUpDown Value="{Binding DraftCols}" Minimum="1" Maximum="20" FormatString="0" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="幅 (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasWidth}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="FormSection">
                            <TextBlock Classes="FieldLabel" Text="高さ (px)" />
                            <NumericUpDown Value="{Binding DraftCanvasHeight}" Minimum="1" Maximum="8192" FormatString="0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="FieldLabel" Text="列比率（カンマ区切り、空＝均等）" />
                        <TextBox Text="{Binding DraftColWeights}" PlaceholderText="例: 2,1,1（列数と同じ要素数）" />
                    </StackPanel>
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="FieldLabel" Text="行比率（カンマ区切り、空＝均等）" />
                        <TextBox Text="{Binding DraftRowWeights}" PlaceholderText="例: 2,1,1（行数と同じ要素数）" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="作成"
                                Command="{Binding ConfirmCreateCommand}"
                                Classes="accent" />
                        <Button Content="キャンセル"
                                Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="11"
                       Margin="0,8,0,0"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ListBox ItemsSource="{Binding Grids}"
                     SelectedItem="{Binding SelectedGrid}"
                     SelectionMode="Single"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:GridCanvasItemViewModel">
                        <StackPanel Margin="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="●"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           IsVisible="{Binding IsActive}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding GridSizeLabel}" Opacity="0.65" FontSize="11" />
                            <TextBlock Text="{Binding CanvasSizeLabel}" Opacity="0.55" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
