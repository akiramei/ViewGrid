<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:conv="clr-namespace:ViewGrid.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="ViewGrid.Presentation.Views.AssetLibraryView"
             x:DataType="vm:AssetLibraryViewModel">

    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="PathToBitmap" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- P6: ツールバー（アイコン付ボタンに統一、accent クラスで主要アクションを強調） -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding PickFilesAndImportCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="accent"
                        ToolTip.Tip="画像をアセットライブラリに追加">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource AddGeometry}" Width="14" Height="14" />
                        <TextBlock Text="画像を追加" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSelectedCommand}"
                        ToolTip.Tip="選択中のアセットを削除">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource DeleteGeometry}" Width="14" Height="14" />
                        <TextBlock Text="削除" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding SelectedCount, StringFormat='({0} 件選択中)'}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="11"
                           IsVisible="{Binding IsMultiSelected}" />
                <Button Command="{Binding LoadCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="アセット一覧を再読み込み">
                    <StackPanel Classes="IconButtonContent">
                        <PathIcon Data="{StaticResource RefreshGeometry}" Width="14" Height="14" />
                        <TextBlock Text="再読み込み" />
                    </StackPanel>
                </Button>
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="120"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ステータスバー（パネル内、件数 + メッセージ表示） -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Opacity="0.75"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Assets.Count, StringFormat='{}{0} 件'}"
                           Opacity="0.75"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- P7: 空状態の案内（アセット 0 件のとき）。アイコン + 操作誘導文 -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding !Assets.Count}"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource ImageGeometry}"
                          Width="48" Height="48"
                          Opacity="0.4" />
                <TextBlock Text="まだ画像がありません"
                           FontSize="16"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
                <TextBlock Text="「画像を追加」ボタンまたはドラッグ＆ドロップで追加できます"
                           FontSize="12"
                           Opacity="0.5"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- アセット一覧（カード化されたグリッド） -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="AssetList"
                     ItemsSource="{Binding Assets}"
                     SelectedItem="{Binding SelectedAsset}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnAssetListSelectionChanged"
                     Background="Transparent"
                     Padding="12">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:AssetItemViewModel">
                        <Border Width="180"
                                Padding="8"
                                Margin="4"
                                CornerRadius="8"
                                Background="{DynamicResource ViewGridCardBackground}"
                                BorderBrush="{DynamicResource ViewGridCardBorder}"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="160" Height="160"
                                        Background="{DynamicResource SystemAltMediumLowColor}"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailAbsolutePath, Converter={StaticResource PathToBitmap}}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Dimensions}"
                                           Opacity="0.7"
                                           FontSize="11" />
                                <TextBlock Text="{Binding FileSizeDisplay}"
                                           Opacity="0.7"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>
