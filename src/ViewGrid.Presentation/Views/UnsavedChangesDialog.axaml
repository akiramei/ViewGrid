<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="200"
        x:Class="ViewGrid.Presentation.Views.UnsavedChangesDialog"
        Width="460"
        SizeToContent="Height"
        MinHeight="170"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        未保存の編集があるまま別の対象へ移る / 終了するときの 3 択。
        保存 = Enter (既定)、 戻る = Esc。 ×で閉じた場合も「戻る」 (編集を失わない側) として扱う。
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,12" />

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="SaveButton"
                    Classes="accent"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Click="OnSaveClicked" />
            <Button x:Name="DiscardButton"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    Click="OnDiscardClicked" />
            <Button x:Name="CancelButton"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>
    </Grid>
</Window>
