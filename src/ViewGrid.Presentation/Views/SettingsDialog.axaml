<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ViewGrid.Application.ViewModels"
        xmlns:converters="using:ViewGrid.Presentation.Converters"
        xmlns:settings="using:ViewGrid.Core.Settings"
        xmlns:loc="using:ViewGrid.Presentation.Localization"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="ViewGrid.Presentation.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="{loc:Tr Settings_Title}"
        Icon="avares://ViewGrid.Presentation/Assets/icon-256.png"
        Width="520" Height="560"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- 言語 -->
                <Border Classes="Card">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="SectionHeader" Text="{loc:Tr Settings_Language}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_Language_Hint}"
                                   Margin="0,0,0,4" />

                        <RadioButton GroupName="Language"
                                     Content="{loc:Tr Settings_Language_System}"
                                     IsChecked="{Binding IsLanguageSystem}" />
                        <RadioButton GroupName="Language"
                                     Content="{loc:Tr Settings_Language_Japanese}"
                                     IsChecked="{Binding IsLanguageJa}" />
                        <RadioButton GroupName="Language"
                                     Content="{loc:Tr Settings_Language_English}"
                                     IsChecked="{Binding IsLanguageEn}" />
                    </StackPanel>
                </Border>

                <!-- 表示 (テーマ) -->
                <Border Classes="Card">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="SectionHeader" Text="{loc:Tr Settings_Display}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_Display_Hint}"
                                   Margin="0,0,0,4" />

                        <RadioButton GroupName="Theme"
                                     Content="{loc:Tr Settings_Theme_System}"
                                     IsChecked="{Binding IsThemeDefault}" />
                        <RadioButton GroupName="Theme"
                                     Content="{loc:Tr Settings_Theme_Light}"
                                     IsChecked="{Binding IsThemeLight}" />
                        <RadioButton GroupName="Theme"
                                     Content="{loc:Tr Settings_Theme_Dark}"
                                     IsChecked="{Binding IsThemeDark}" />

                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_AccentColor}" Margin="0,12,0,0" />
                        <ItemsControl x:Name="AccentPresetItems"
                                      ItemsSource="{Binding AccentColorPresetOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="settings:AccentColorPreset">
                                    <!-- 外枠 Border: 選択中はアクセント色で 2px の枠を表示 -->
                                    <Border CornerRadius="20" Padding="2"
                                            BorderBrush="{DynamicResource SystemAccentColor}">
                                        <Border.BorderThickness>
                                            <MultiBinding Converter="{x:Static converters:AccentSelectionThicknessConverter.Instance}">
                                                <Binding Path="Id" />
                                                <Binding Path="((vm:SettingsDialogViewModel)DataContext).AccentColor"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Border.BorderThickness>
                                        <!--
                                            色ドット: 32x32 の円。 Button だと FluentTheme の :pointerover
                                            スタイルが Background を薄いグレーに上書きして Swatch 色が見えなく
                                            なるため、 Border + PointerPressed ハンドラで実装する。
                                        -->
                                        <Border Width="32" Height="32"
                                                CornerRadius="16"
                                                Cursor="Hand"
                                                Background="{Binding SwatchColor, Converter={x:Static converters:HexToBrushConverter.Instance}}"
                                                Tag="{Binding Id}"
                                                PointerPressed="OnAccentPresetPressed"
                                                ToolTip.Tip="{Binding DisplayName}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 既定値 -->
                <Border Classes="Card">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="SectionHeader" Text="{loc:Tr Settings_Defaults}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_Defaults_Hint}"
                                   Margin="0,0,0,4" />

                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_DefaultScaling}" />
                        <ComboBox ItemsSource="{Binding ScalingModeOptions}"
                                  SelectedItem="{Binding DefaultScalingMode}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_DefaultAutoCrop}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding AutoCropPresetOptions}"
                                  SelectedItem="{Binding DefaultAutoCropPreset}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- 保存動作 -->
                <Border Classes="Card">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="SectionHeader" Text="{loc:Tr Settings_Save}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_AutoSave_Hint}"
                                   Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Tr Settings_AutoSave_Toggle}"
                                  IsChecked="{Binding EnableAutoSave}" />
                    </StackPanel>
                </Border>

                <!-- 詳細 (サムネ) -->
                <Border Classes="Card">
                    <StackPanel Classes="FormSection">
                        <TextBlock Classes="SectionHeader" Text="{loc:Tr Settings_Advanced}" />
                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_ThumbMaxEdge}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_ThumbMaxEdge_Hint}"
                                   Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton GroupName="ThumbSize" Content="256" IsChecked="{Binding IsThumb256}" />
                            <RadioButton GroupName="ThumbSize" Content="512" IsChecked="{Binding IsThumb512}" />
                            <RadioButton GroupName="ThumbSize" Content="1024" IsChecked="{Binding IsThumb1024}" />
                            <RadioButton GroupName="ThumbSize" Content="2048" IsChecked="{Binding IsThumb2048}" />
                        </StackPanel>

                        <!-- 既存サムネ全件再生成 -->
                        <Border Background="{DynamicResource ViewGridCardBorder}"
                                Height="1" Margin="0,12,0,12" />
                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_RegenThumbs}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_RegenThumbs_Hint}"
                                   Margin="0,0,0,4" />
                        <Button Content="{loc:Tr Settings_RegenThumbs_Button}"
                                HorizontalAlignment="Left"
                                Click="OnRegenerateThumbnailsClicked" />

                        <!-- 設定の入出力 (JSON エクスポート / インポート) -->
                        <Border Background="{DynamicResource ViewGridCardBorder}"
                                Height="1" Margin="0,12,0,12" />
                        <TextBlock Classes="FieldLabel" Text="{loc:Tr Settings_ImportExport}" />
                        <TextBlock Classes="HintText"
                                   Text="{loc:Tr Settings_ImportExport_Hint}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Tr Settings_Export}" Command="{Binding ExportSettingsCommand}" />
                            <Button Content="{loc:Tr Settings_Import}" Command="{Binding ImportSettingsCommand}" />
                        </StackPanel>
                        <TextBlock Classes="HintText"
                                   Text="{Binding IoStatus}"
                                   IsVisible="{Binding HasIoStatus}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 下部: 閉じる -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Spacing="8">
            <Button Content="{loc:Tr Common_Close}"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
