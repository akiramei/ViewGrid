<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="ViewGrid.Presentation.Views.PlacementInspectorView"
             x:DataType="vm:PlacementInspectorViewModel">

    <Border Padding="6,8"
            CornerRadius="4"
            Background="{DynamicResource SystemChromeLowColor}"
            IsVisible="{Binding HasPlacement}">
        <!--
            配置ファースト UI 第 2 段階 Stage 3: PlacementInspector に CopyPropertiesView を inline embed。
            「特性を編集 →」のタブ遷移は撤去（CopyPropertiesView を直下に置くのでナビゲーション不要）。
            上から: ヘッダ → 配置固有 (PixelOffset + 保存/リセット) → 分岐ボタン → 共有特性 (CopyPropertiesView)。
            CopyProperties は Inspector が AttachAsync で当該 placement の variant に紐付ける。
        -->
        <!--
            旧版は外側 ScrollViewer + 内側 CopyPropertiesView の TabItem ScrollViewer の
            二重スクロール構造で、内側の有効高さが Tab 領域に縛られて最後のフィールド
            （占有セル NumericUpDown）の下端が見切れる問題があった。外側 ScrollViewer を
            撤去し、Grid の RowDefinitions で「配置固有 = Auto / 共有特性 = *」に分けて、
            共有特性 = CopyPropertiesView 内部の ScrollViewer が割り当てられた高さを
            使い切って必要なら自前でスクロールする設計にする。
        -->
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Row 0: ヘッダ + 統一保存バー -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding HeaderLabel}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PositionLabel}"
                               FontSize="10"
                               Opacity="0.7" />
                </StackPanel>

                <!-- 統一保存バー: 配置固有 (PixelOffset) + 共有特性 (Rotation/Flip/etc) を一括処理 -->
                <Border Classes="SubtleCard" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding SaveAllCommand}"
                                Classes="accent"
                                ToolTip.Tip="配置固有 + 共有特性 をまとめて保存">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource SaveGeometry}" Width="14" Height="14" />
                                <TextBlock Text="保存" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RevertAllCommand}"
                                ToolTip.Tip="編集前の値に戻す">
                            <StackPanel Classes="IconButtonContent">
                                <PathIcon Data="{StaticResource RefreshGeometry}" Width="14" Height="14" />
                                <TextBlock Text="リセット" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="●"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsAnyDirty}"
                                   ToolTip.Tip="未保存の変更があります" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Row 1: 配置固有 (Auto = 必要分の高さ) -->
            <Border Grid.Row="1" Classes="SubtleCard" Padding="8" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="配置固有"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Opacity="0.85" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="FieldLabel"
                                   Text="ピクセル微調整 (ΔX/ΔY)"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="0 にリセット"
                                FontSize="10"
                                Padding="6,2"
                                Command="{Binding ResetPixelOffsetCommand}" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               Text="{Binding ImageDrawSizeLabel}"
                               IsVisible="{Binding ImageDrawSizeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <NumericUpDown Grid.Column="0"
                                       Value="{Binding PixelOffsetX}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding PixelOffsetY}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               FontStyle="Italic"
                               Text="ヒント: Shift+ドラッグ / Ctrl+矢印でも微調整可" />
                </StackPanel>
            </Border>

            <!--
                Row 2: 共有特性 (* = 残りの高さ全て)。
                スクロール責務はここで親が所有する: 共有特性カード内部を Grid Auto,* に分け、
                Auto = タイトル / * = ScrollViewer + CopyPropertiesView。
                ScrollViewer は finite height をもつ親 (共有特性カードの * 行) に置かれているため
                正しい viewport を持ち、CopyPropertiesView の自然な高さがそれを越えたときだけ
                AllowAutoHide=True でフェードインする overlay scrollbar を出す。
                CopyPropertiesView 自身は内部 ScrollViewer を持たず、自然な高さで縦に流れるだけ。
            -->
            <Border Grid.Row="2" Classes="SubtleCard" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="共有特性（同バリアントを参照する全配置に反映）"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Opacity="0.85"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AllowAutoHide="True"
                                  Padding="0,0,8,0">
                        <views:CopyPropertiesView DataContext="{Binding CopyProperties}"
                                                  ShowSaveBar="False" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--
                Row 3: 分岐ボタン + ステータス。
                ステータスは「配置固有 (Inspector.StatusMessage)」と「共有特性 (CopyProperties.StatusMessage)」を
                両方表示する。ScrollViewer 内の CopyPropertiesView 末尾にも StatusMessage はあるが、
                スクロールしないと見えない位置になりがちなので、保存エラー（OccupySize 範囲外等）が
                ユーザーに即座に伝わるよう Inspector 直下にも表示する。
                エラー時は SystemErrorTextColor で強調する。
            -->
            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                <Button HorizontalAlignment="Stretch"
                        Padding="6,4"
                        FontSize="11"
                        Command="{Binding ForkVariantCommand}"
                        ToolTip.Tip="元バリアントを複製した独立バリアントに切替えます。他の配置には影響しません。">
                    <TextBlock Text="この配置だけ別バリアントに分岐"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}"
                           Opacity="0.7"
                           FontSize="10"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding CopyProperties.StatusMessage}"
                           Foreground="{DynamicResource SystemErrorTextColor}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CopyProperties.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
