<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="320"
             x:Class="ViewGrid.Presentation.Views.PlacementInspectorView"
             x:DataType="vm:PlacementInspectorViewModel">

    <Border Padding="10,8"
            CornerRadius="4"
            Background="{DynamicResource SystemChromeLowColor}"
            IsVisible="{Binding HasPlacement}">
        <DockPanel LastChildFill="True">

            <!-- ヘッダ -->
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
                <TextBlock Text="{Binding HeaderLabel}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PositionLabel}"
                           FontSize="10"
                           Opacity="0.7" />
            </StackPanel>

            <!-- 共有特性は準備タブで編集する旨を案内 + ナビゲーションボタン -->
            <Border DockPanel.Dock="Top"
                    Classes="InfoBanner"
                    Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Classes="HintText"
                               Text="回転・反転・スケーリング等の共有特性は準備タブの「特性編集」で編集します（同じバリアントの全配置に反映）。" />
                    <Button Content="特性を編集 →"
                            HorizontalAlignment="Stretch"
                            Padding="6,2"
                            FontSize="11"
                            Command="{Binding EditCopyPropertiesCommand}" />
                </StackPanel>
            </Border>

            <!-- アクション -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        Classes="accent" />
                <Button Content="リセット"
                        Command="{Binding RevertCommand}" />
                <TextBlock Text="*"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SystemAccentColor}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsDirty}"
                           ToolTip.Tip="未保存の変更があります" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7"
                       FontSize="10"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- ピクセル微調整（配置固有プロパティ） -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Classes="FormSection">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="FieldLabel"
                                   Text="ピクセル微調整 (ΔX/ΔY)"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="0 にリセット"
                                FontSize="10"
                                Padding="6,2"
                                Command="{Binding ResetPixelOffsetCommand}" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               Text="{Binding ImageDrawSizeLabel}"
                               IsVisible="{Binding ImageDrawSizeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <NumericUpDown Grid.Column="0"
                                       Value="{Binding PixelOffsetX}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding PixelOffsetY}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               FontStyle="Italic"
                               Text="ヒント: キャンバス上で Shift+ドラッグでも微調整可能（保存ボタンで永続化）" />
                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>
