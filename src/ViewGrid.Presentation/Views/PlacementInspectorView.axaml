<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ViewGrid.Application.ViewModels;assembly=ViewGrid.Application"
             xmlns:views="clr-namespace:ViewGrid.Presentation.Views"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Name="InspectorRoot"
             x:Class="ViewGrid.Presentation.Views.PlacementInspectorView"
             x:DataType="vm:PlacementInspectorViewModel">

    <Border Padding="6,8"
            CornerRadius="4"
            Background="{DynamicResource SystemChromeLowColor}"
            IsVisible="{Binding HasPlacement}">
        <!--
            配置ファースト UI 第 2 段階 Stage 3: PlacementInspector に CopyPropertiesView を inline embed。
            「特性を編集 →」のタブ遷移は撤去（CopyPropertiesView を直下に置くのでナビゲーション不要）。
            上から: ヘッダ → 配置固有 (PixelOffset + 保存/リセット) → 分岐ボタン → 共有特性 (CopyPropertiesView)。
            CopyProperties は Inspector が AttachAsync で当該 placement の variant に紐付ける。
        -->
        <!--
            スクロールは右ペイン全体 (GridWorkspaceView の Column 2) で 1 本に統一する。
            Inspector 内部にスクロールを持たないため、共有特性カード * の内部 ScrollViewer は
            撤去 (本ファイル下部参照)。Row も「Auto,Auto,Auto,Auto」で全て自然な高さに流れる。
            旧来の「配置固有 = Auto / 共有特性 = *」二重スクロールは入れ子で操作感が悪く、
            最終フィールドが見切れる問題もあったので右ペイン外側スクロールに一本化。
        -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- Row 0: ヘッダ + 統一保存バー -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding HeaderLabel}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PositionLabel}"
                               FontSize="10"
                               Opacity="0.7" />
                </StackPanel>

                <!--
                    統一保存バー: 配置固有 (PixelOffset) + 共有特性 (Rotation/Flip/etc) を一括処理。
                    右端に「配置を削除」(iconDanger) を Spacer 列で離して配置することで、 placement レベルの
                    操作 (保存 / リセット / 削除) を 1 箇所に視覚統合する。 削除コマンドは親 (GridWorkspaceVM) の
                    RemoveSelectedPlacementCommand を、 UserControl 独自 NameScope を跨ぐ AvaloniaProperty
                    (#InspectorRoot.RemoveCommand) 経由で受け取る。
                -->
                <Border Classes="SubtleCard" Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding SaveAllCommand}"
                                    Classes="accent"
                                    ToolTip.Tip="配置固有 + 共有特性 をまとめて保存">
                                <StackPanel Classes="IconButtonContent">
                                    <PathIcon Data="{StaticResource SaveGeometry}" Width="14" Height="14" />
                                    <TextBlock Text="保存" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RevertAllCommand}"
                                    ToolTip.Tip="編集前の値に戻す">
                                <StackPanel Classes="IconButtonContent">
                                    <PathIcon Data="{StaticResource RefreshGeometry}" Width="14" Height="14" />
                                    <TextBlock Text="リセット" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="●"
                                       FontSize="14"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsAnyDirty}"
                                       ToolTip.Tip="未保存の変更があります" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="配置を削除"
                                Classes="iconDanger"
                                Command="{Binding #InspectorRoot.RemoveCommand}"
                                ToolTip.Tip="この配置を削除します" />
                    </Grid>
                </Border>
            </StackPanel>

            <!--
                Row 1: 配置固有 (Auto = 必要分の高さ)。
                出力設定 Expander と同じ折り畳みパターンに揃えて縦密度を制御可能にする。
                操作頻度は共有特性より低い (一度決めた占有セル / PixelOffset を頻繁に変えない) ため、
                IsExpanded=False を既定にして縦スペースを共有特性に譲る。
                ヘッダーの副表示で 「N×M / Δ(x,y)」 形式の現在値を畳んだまま確認できる。
            -->
            <Expander Grid.Row="1"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="配置固有"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Opacity="0.6"
                                   FontSize="11"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding OccupyWidth, Mode=OneWay}" />
                            <Run Text="×" />
                            <Run Text="{Binding OccupyHeight, Mode=OneWay}" />
                            <Run Text=" / Δ(" />
                            <Run Text="{Binding PixelOffsetX, Mode=OneWay}" />
                            <Run Text="," />
                            <Run Text="{Binding PixelOffsetY, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="6">
                    <!-- 占有セル W×H (配置単位の固有特性) -->
                    <TextBlock Classes="FieldLabel" Text="占有セル (W×H)" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <NumericUpDown Grid.Column="0"
                                       Value="{Binding OccupyWidth}"
                                       Minimum="1" Maximum="20"
                                       Increment="1"
                                       FormatString="0" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding OccupyHeight}"
                                       Minimum="1" Maximum="20"
                                       Increment="1"
                                       FormatString="0" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               FontStyle="Italic"
                               Text="この配置のみ占有セルが変わります（同バリアントの別配置には影響しません）" />

                    <!-- ピクセル微調整 ΔX/ΔY -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0"
                                   Classes="FieldLabel"
                                   Text="ピクセル微調整 (ΔX/ΔY)"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="0 にリセット"
                                FontSize="10"
                                Padding="6,2"
                                Command="{Binding ResetPixelOffsetCommand}" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               Text="{Binding ImageDrawSizeLabel}"
                               IsVisible="{Binding ImageDrawSizeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <NumericUpDown Grid.Column="0"
                                       Value="{Binding PixelOffsetX}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding PixelOffsetY}"
                                       Minimum="-4096" Maximum="4096"
                                       Increment="1"
                                       FormatString="0" />
                    </Grid>
                    <TextBlock Classes="HintText"
                               FontStyle="Italic"
                               Text="ヒント: Shift+ドラッグ / Ctrl+矢印でも微調整可" />
                </StackPanel>
            </Expander>

            <!--
                Row 2: 共有特性 (Auto = 自然な高さ)。
                placement 編集の主戦場 (Rotation/Flip/Scaling/Alignment/AutoCrop/ManualCrop) で
                操作頻度が最も高いため IsExpanded=True を既定にして即アクセス可能に。
                内部 ScrollViewer は撤去済み (右ペイン全体 ScrollViewer 1 本に集約)、
                Inspector 自身は素直に縦に伸びる。
            -->
            <Expander Grid.Row="2"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="共有特性（同バリアントを参照する全配置に反映）"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Expander.Header>
                <views:CopyPropertiesView DataContext="{Binding CopyProperties}"
                                          ShowSaveBar="False" />
            </Expander>

            <!--
                Row 3: 分岐ボタン + ステータス。
                ステータスは「配置固有 (Inspector.StatusMessage)」と「共有特性 (CopyProperties.StatusMessage)」を
                両方表示する。ScrollViewer 内の CopyPropertiesView 末尾にも StatusMessage はあるが、
                スクロールしないと見えない位置になりがちなので、保存エラー（OccupySize 範囲外等）が
                ユーザーに即座に伝わるよう Inspector 直下にも表示する。
                エラー時は SystemErrorTextColor で強調する。
            -->
            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                <Button HorizontalAlignment="Stretch"
                        Padding="6,4"
                        FontSize="11"
                        Command="{Binding ForkVariantCommand}"
                        ToolTip.Tip="元バリアントを複製した独立バリアントに切替えます。他の配置には影響しません。">
                    <TextBlock Text="この配置だけ別バリアントに分岐"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}"
                           Opacity="0.7"
                           FontSize="10"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding CopyProperties.StatusMessage}"
                           Foreground="{DynamicResource SystemErrorTextColor}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CopyProperties.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
